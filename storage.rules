rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return signedIn()
        && request.auth.uid in [
          'LTk2AdDOAIVGhlkt97fnbD5TXIf1',
          '7FNrECQeqAca9Vu8lBBzTSdcJcg1'
        ];
    }

    function isShopMember(shopId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/shop_members/$(shopId + '_' + request.auth.uid)
        );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
  return request.resource.size <= 5 * 1024 * 1024;
}

    // 🐾 會員寵物照片：pets/{uid}/{petId}.jpg
    match /pets/{uid}/{fileName} {
  allow read: if signedIn()
  && (
    request.auth.uid == uid ||
    isRootAdmin()
  );

  allow write: if signedIn()
    && request.auth.uid == uid
    && request.resource.contentType == 'image/jpeg'
    && request.resource.size < 6 * 1024 * 1024;
}

    // 🏪 店家所有圖片：shops/{shopId}/...
    // 包含：
    // shops/{shopId}/logo.jpg
    // shops/{shopId}/banner_xxx.jpg
    // shops/{shopId}/room_types/{roomTypeId}/xxx.jpg
    // shops/{shopId}/platform_home_cover/xxx.jpg
    // shops/{shopId}/platform_home_logo/xxx.jpg
    match /shops/{shopId}/{allPaths=**} {
  allow read: if true;

  // 新增或更換圖片：
  // 必須是店家成員或平台管理員，
  // 並限制為圖片且最大 5 MB。
  allow create, update: if (isShopMember(shopId) || isRootAdmin())
    && isImage()
    && isUnder5MB();

  // 刪除圖片時 request.resource 不存在，
  // 因此不能再檢查 contentType 或 size。
  allow delete: if isShopMember(shopId) || isRootAdmin();
}

// 📸 客戶上傳匯款證明
match /booking_images/{bookingId}/{fileName} {

  allow read: if signedIn()
    && (
      isRootAdmin() ||
      firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data.userId == request.auth.uid ||
      isShopMember(
        firestore.get(
          /databases/(default)/documents/bookings/$(bookingId)
        ).data.shopId
      )
    );

  allow write: if signedIn()
    && isImage()
    && isUnder5MB()
    && (
      isRootAdmin() ||
      firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data.userId == request.auth.uid ||
      isShopMember(
        firestore.get(
          /databases/(default)/documents/bookings/$(bookingId)
        ).data.shopId
      )
    );
}

// ⭐ 評價照片
match /review_images/{bookingId}/{fileName} {

  allow read: if true;

  allow write: if signedIn()
    && isImage()
    && isUnder5MB()
    && (
      isRootAdmin() ||
      firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data.userId == request.auth.uid
    );
}

// 📸 店家退房額外費用照片
match /booking_extra_charges/{bookingId}/{fileName} {
  allow read: if signedIn()
  && (
    isRootAdmin() ||
    firestore.get(
      /databases/(default)/documents/bookings/$(bookingId)
    ).data.userId == request.auth.uid ||
    isShopMember(
      firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data.shopId
    )
  );

  allow write: if signedIn()
    && isImage()
    && isUnder5MB()
    && (
      isRootAdmin() ||
      isShopMember(
        firestore.get(
          /databases/(default)/documents/bookings/$(bookingId)
        ).data.shopId
      )
    );
}

// 📮 店主聯絡平台附件
match /platform_contact_requests/{requestId}/{fileName} {
  allow read: if signedIn()
  && (
    isRootAdmin() ||
    isShopMember(
      firestore.get(
        /databases/(default)/documents/platform_contact_requests/$(requestId)
      ).data.shopId
    )
  );

  allow write: if signedIn()
    && isImage()
    && isUnder5MB()
    && (
      isRootAdmin() ||
      isShopMember(
        firestore.get(
          /databases/(default)/documents/platform_contact_requests/$(requestId)
        ).data.shopId
      )
    );
}
    // ✅ 店家認證／平台公開申請照片
    match /shop_verify_requests/{shopId}/{folderName}/{fileName} {
      allow read: if signedIn()
        && (
          isRootAdmin() ||
          isShopMember(shopId)
        );

      allow write: if signedIn()
        && isImage()
        && isUnder5MB()
        && (
          isRootAdmin() ||
          isShopMember(shopId)
        );
    }

    // 🚫 其他 Storage 路徑全部拒絕
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}