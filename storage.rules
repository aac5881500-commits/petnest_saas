rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return signedIn()
        && request.auth.uid in [
          'LTk2AdDOAIVGhlkt97fnbD5TXIf1',
          '7FNrECQeqAca9Vu8lBBzTSdcJcg1'
        ];
    }

    function isShopMember(shopId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/shop_members/$(shopId + '_' + request.auth.uid)
        );
    }

    function shopMemberDoc(shopId) {
      return /databases/(default)/documents/shop_members/$(shopId + '_' + request.auth.uid);
    }

    function isShopOwner(shopId) {
      return isShopMember(shopId)
        && firestore.get(shopMemberDoc(shopId)).data.role == 'owner';
    }

    function isShopOwnerUid(shopId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/shops/$(shopId))
        && firestore.get(
          /databases/(default)/documents/shops/$(shopId)
        ).data.ownerUid == request.auth.uid;
    }

    // 與 Firestore hasShopPermissionKey 相同：店主或 permissions[key] == true。
    function hasShopPermission(shopId, permissionKey) {
      return isRootAdmin()
        || isShopOwnerUid(shopId)
        || isShopOwner(shopId)
        || (
          isShopMember(shopId)
          && firestore.get(shopMemberDoc(shopId)).data.keys().hasAny(['permissions'])
          && firestore.get(shopMemberDoc(shopId)).data.permissions is map
          && firestore.get(shopMemberDoc(shopId)).data.permissions.get(permissionKey, false) == true
        );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isUnder6MB() {
      return request.resource.size < 6 * 1024 * 1024;
    }

    function platformUserPath() {
      return /databases/(default)/documents/platform_users/$(request.auth.uid);
    }

    function isEnabledPlatformUserData(data) {
      return !data.keys().hasAny(['enabled']) || data.enabled == true;
    }

    function platformUserCanManageMedia(data) {
      return isEnabledPlatformUserData(data)
        && (
          data.role == 'super_admin'
          || (
            data.keys().hasAny(['permissions'])
            && data.permissions.hasAny(['all', 'manage_platform_media'])
          )
        );
    }

    function canManagePlatformMedia() {
      return isRootAdmin()
        || (
          signedIn()
          && firestore.exists(platformUserPath())
          && platformUserCanManageMedia(firestore.get(platformUserPath()).data)
        );
    }

    function isPlatformLibraryImage() {
      return request.resource.contentType.matches('image/jpeg.*')
        || request.resource.contentType.matches('image/jpg.*')
        || request.resource.contentType.matches('image/png.*')
        || request.resource.contentType.matches('image/webp.*');
    }

    function bookingDoc(bookingId) {
      return firestore.get(
        /databases/(default)/documents/bookings/$(bookingId)
      ).data;
    }

    function bookingExists(bookingId) {
      return firestore.exists(
        /databases/(default)/documents/bookings/$(bookingId)
      );
    }

    function canReadBookingFile(bookingId) {
      return signedIn()
        && bookingExists(bookingId)
        && (
          isRootAdmin()
          || bookingDoc(bookingId).userId == request.auth.uid
          || isShopMember(bookingDoc(bookingId).shopId)
          || isShopOwnerUid(bookingDoc(bookingId).shopId)
        );
    }

    function dailyCareBooking(bookingId) {
      return bookingDoc(bookingId);
    }

    function dailyCareWritable(shopId, bookingId) {
      return bookingExists(bookingId)
        && dailyCareBooking(bookingId).shopId == shopId
        && dailyCareBooking(bookingId).status == 'checked_in'
        && dailyCareBooking(bookingId).status != 'checked_out'
        && dailyCareBooking(bookingId).status != 'completed'
        && dailyCareBooking(bookingId).status != 'cancelled'
        && dailyCareBooking(bookingId).settlementConfirmed != true
        && !('settledAt' in dailyCareBooking(bookingId)
          && dailyCareBooking(bookingId).settledAt != null);
    }

    function canWriteDailyCare(shopId) {
      return isRootAdmin()
        || hasShopPermission(shopId, 'manage_room_dashboard')
        || hasShopPermission(shopId, 'manage_daycare_bookings')
        || hasShopPermission(shopId, 'manage_bookings');
    }

    function dailyCareCustomerCanRead(shopId, bookingId, photoId) {
      return bookingExists(bookingId)
        && dailyCareBooking(bookingId).shopId == shopId
        && dailyCareBooking(bookingId).userId is string
        && dailyCareBooking(bookingId).userId.size() > 0
        && dailyCareBooking(bookingId).userId == request.auth.uid
        && (
          !firestore.exists(
            /databases/(default)/documents/daily_care_photos/$(photoId)
          )
          ||
          !('expiresAt' in firestore.get(
            /databases/(default)/documents/daily_care_photos/$(photoId)
          ).data)
          ||
          firestore.get(
            /databases/(default)/documents/daily_care_photos/$(photoId)
          ).data.expiresAt == null
          ||
          request.time < firestore.get(
            /databases/(default)/documents/daily_care_photos/$(photoId)
          ).data.expiresAt
        );
    }

    function canReadDailyCarePreview(shopId, bookingId, photoId) {
      return signedIn()
        && (
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || dailyCareCustomerCanRead(shopId, bookingId, photoId)
        );
    }

    // 🐾 會員頭像與寵物照片：pets/{uid}/{fileName}
    // App 上傳前已轉成 JPEG。寵物既有上限是小於 6MB，頭像 App 自己先擋 5MB。
    match /pets/{uid}/{fileName} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || isRootAdmin()
        );

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && isUnder6MB();

      allow delete: if signedIn()
        && request.auth.uid == uid;
    }

    // 公開店家素材。只列出前台實際使用的路徑，不開放 shops/{shopId}/**。
    function allowPublicImageWrite(shopId) {
      return signedIn() && isImage() && isUnder5MB();
    }

    function isShopLogoOrBanner(fileName) {
      return fileName == 'logo.jpg' || fileName.matches('banner_.*');
    }

    match /shops/{shopId}/{fileName} {
      allow read: if isShopLogoOrBanner(fileName);
      allow create, update: if isShopLogoOrBanner(fileName)
        && allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'edit_media');
      allow delete: if isShopLogoOrBanner(fileName)
        && hasShopPermission(shopId, 'edit_media');
    }

    match /shops/{shopId}/platform_home_cover/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'edit_media');
      allow delete: if hasShopPermission(shopId, 'edit_media');
    }

    match /shops/{shopId}/platform_home_logo/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'edit_media');
      allow delete: if hasShopPermission(shopId, 'edit_media');
    }

    match /shops/{shopId}/environment/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_environment')
          || hasShopPermission(shopId, 'manage_frontend_content')
        );
      allow delete: if hasShopPermission(shopId, 'manage_environment')
        || hasShopPermission(shopId, 'manage_frontend_content');
    }

    match /shops/{shopId}/about/{allPaths=**} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_about')
          || hasShopPermission(shopId, 'manage_frontend_content')
        );
      allow delete: if hasShopPermission(shopId, 'manage_about')
        || hasShopPermission(shopId, 'manage_frontend_content');
    }

    match /shops/{shopId}/room_types/{roomTypeId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'manage_room_types');
      allow delete: if hasShopPermission(shopId, 'manage_room_types');
    }

    match /shops/{shopId}/home/banners/{bannerId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'edit_media')
        );
      allow delete: if hasShopPermission(shopId, 'manage_frontend_content')
        || hasShopPermission(shopId, 'edit_media');
    }

    // 首頁海報原圖：shops/{shopId}/home/banners/{bannerId}/p_{時間}/cover.jpg
    match /shops/{shopId}/home/banners/{bannerId}/{versionFolder}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'edit_media')
        );
      allow delete: if hasShopPermission(shopId, 'manage_frontend_content')
        || hasShopPermission(shopId, 'edit_media');
    }

    // 首頁商城入口背景：shops/{shopId}/home/store_entry_card/p_{時間}/cover.jpg
    match /shops/{shopId}/home/store_entry_card/{versionFolder}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'edit_media')
        );
      allow delete: if hasShopPermission(shopId, 'manage_frontend_content')
        || hasShopPermission(shopId, 'edit_media');
    }

    match /shops/{shopId}/store/banners/{bannerId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_store_products')
          || hasShopPermission(shopId, 'manage_store_settings')
        );
      allow delete: if hasShopPermission(shopId, 'manage_store_products')
        || hasShopPermission(shopId, 'manage_store_settings');
    }

    // 商城海報原圖：shops/{shopId}/store/banners/{bannerId}/p_{時間}/cover.jpg
    match /shops/{shopId}/store/banners/{bannerId}/{versionFolder}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_store_products')
          || hasShopPermission(shopId, 'manage_store_settings')
        );
      allow delete: if hasShopPermission(shopId, 'manage_store_products')
        || hasShopPermission(shopId, 'manage_store_settings');
    }

    match /shops/{shopId}/store/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'manage_store_products');
      allow delete: if hasShopPermission(shopId, 'manage_store_products');
    }

    match /shops/{shopId}/inventory/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'manage_inventory');
      allow delete: if hasShopPermission(shopId, 'manage_inventory');
    }

    match /shops/{shopId}/point_rewards/{rewardId}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && hasShopPermission(shopId, 'manage_member_points');
      allow delete: if hasShopPermission(shopId, 'manage_member_points');
    }

    match /shops/{shopId}/booking_entry/{kind}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'manage_booking_settings')
        );
      allow delete: if hasShopPermission(shopId, 'manage_frontend_content')
        || hasShopPermission(shopId, 'manage_booking_settings');
    }

    match /shops/{shopId}/pre_arrival_guides/{serviceType}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (serviceType == 'accommodation' || serviceType == 'daycare')
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'manage_booking_settings')
          || hasShopPermission(shopId, 'manage_policy')
        );
      allow delete: if (serviceType == 'accommodation' || serviceType == 'daycare')
        && (
          hasShopPermission(shopId, 'manage_frontend_content')
          || hasShopPermission(shopId, 'manage_booking_settings')
          || hasShopPermission(shopId, 'manage_policy')
        );
    }

    // 日誌卡片背景是店家素材，不是顧客或寵物照片。
    match /shops/{shopId}/daily_care/settings/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if allowPublicImageWrite(shopId)
        && (
          hasShopPermission(shopId, 'manage_daycare_settings')
          || hasShopPermission(shopId, 'manage_frontend_content')
        );
      allow delete: if hasShopPermission(shopId, 'manage_daycare_settings')
        || hasShopPermission(shopId, 'manage_frontend_content');
    }

    match /shop_chat/{shopId}/{customerUid}/{allPaths=**} {
      allow read: if signedIn()
        && (
          request.auth.uid == customerUid
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || isRootAdmin()
        );

      allow create, update: if signedIn()
        && isImage()
        && isUnder5MB()
        && (
          request.auth.uid == customerUid
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || isRootAdmin()
        );

      allow delete: if signedIn()
        && (
          request.auth.uid == customerUid
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || isRootAdmin()
        );
    }

    match /booking_images/{bookingId}/{fileName} {
      allow read: if canReadBookingFile(bookingId);

      allow create, update: if canReadBookingFile(bookingId)
        && isImage()
        && isUnder5MB();

      allow delete: if canReadBookingFile(bookingId);
    }

    match /review_images/{bookingId}/{fileName} {
      allow read: if true;

      allow create, update: if signedIn()
        && isImage()
        && isUnder5MB()
        && (
          isRootAdmin()
          || (
            bookingExists(bookingId)
            && bookingDoc(bookingId).userId == request.auth.uid
          )
        );

      allow delete: if signedIn()
        && (
          isRootAdmin()
          || (
            bookingExists(bookingId)
            && bookingDoc(bookingId).userId == request.auth.uid
          )
        );
    }

    match /booking_extra_charges/{bookingId}/{fileName} {
      allow read: if canReadBookingFile(bookingId);

      allow create, update: if signedIn()
        && isImage()
        && isUnder5MB()
        && bookingExists(bookingId)
        && (
          isRootAdmin()
          || isShopMember(bookingDoc(bookingId).shopId)
          || isShopOwnerUid(bookingDoc(bookingId).shopId)
        );

      allow delete: if signedIn()
        && bookingExists(bookingId)
        && (
          isRootAdmin()
          || isShopMember(bookingDoc(bookingId).shopId)
          || isShopOwnerUid(bookingDoc(bookingId).shopId)
        );
    }

    match /platform_contact_requests/{requestId}/{fileName} {
      allow read: if signedIn()
        && (
          isRootAdmin()
          || isShopMember(
            firestore.get(
              /databases/(default)/documents/platform_contact_requests/$(requestId)
            ).data.shopId
          )
        );

      allow create, update: if signedIn()
        && isImage()
        && isUnder5MB()
        && (
          isRootAdmin()
          || isShopMember(
            firestore.get(
              /databases/(default)/documents/platform_contact_requests/$(requestId)
            ).data.shopId
          )
        );

      allow delete: if signedIn()
        && (
          isRootAdmin()
          || isShopMember(
            firestore.get(
              /databases/(default)/documents/platform_contact_requests/$(requestId)
            ).data.shopId
          )
        );
    }

    match /shop_verify_requests/{shopId}/{folderName}/{fileName} {
      allow read: if signedIn()
        && (
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
        );

      allow create, update: if signedIn()
        && isImage()
        && isUnder5MB()
        && (
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
        );

      allow delete: if signedIn()
        && (
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
        );
    }

    match /daily_care_photos/{shopId}/{bookingId}/{roomId}/{dateKey}/{sessionIndex}/{photoId}/preview.jpg {
      allow read: if canReadDailyCarePreview(shopId, bookingId, photoId);

      allow create, update: if canWriteDailyCare(shopId)
        && dailyCareWritable(shopId, bookingId)
        && isImage()
        && isUnder5MB();

      allow delete: if canWriteDailyCare(shopId)
        && dailyCareWritable(shopId, bookingId);
    }

    match /daily_care_photos/{shopId}/{bookingId}/{roomId}/{dateKey}/{sessionIndex}/{photoId}/download.jpg {
      allow read: if signedIn()
        && (
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || (
            dailyCareCustomerCanRead(shopId, bookingId, photoId)
            && firestore.exists(
              /databases/(default)/documents/daily_care_photo_downloads/$(photoId)
            )
            && firestore.get(
              /databases/(default)/documents/daily_care_photo_downloads/$(photoId)
            ).data.bookingId == bookingId
            && firestore.get(
              /databases/(default)/documents/daily_care_photo_downloads/$(photoId)
            ).data.shopId == shopId
          )
        );

      allow create, update: if canWriteDailyCare(shopId)
        && dailyCareWritable(shopId, bookingId)
        && isImage()
        && isUnder5MB();

      allow delete: if canWriteDailyCare(shopId)
        && dailyCareWritable(shopId, bookingId);
    }

    match /platform/media_library/{assetId}/{fileName} {
      allow read: if signedIn() && (
        canManagePlatformMedia()
        || (
          firestore.exists(
            /databases/(default)/documents/platform_media_library/$(assetId)
          )
          && firestore.get(
            /databases/(default)/documents/platform_media_library/$(assetId)
          ).data.enabled == true
        )
      );
      allow create, update: if canManagePlatformMedia()
        && isPlatformLibraryImage()
        && isUnder5MB();
      allow delete: if canManagePlatformMedia();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
