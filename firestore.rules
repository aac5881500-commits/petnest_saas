rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 登入判斷
    function signedIn() {
      return request.auth != null;
    }

    // 👑 平台最高權限
    function isRootAdmin() {
      return signedIn()
        && request.auth.uid in [
          'LTk2AdDOAIVGhlkt97fnbD5TXIf1',
          '7FNrECQeqAca9Vu8lBBzTSdcJcg1'
        ];
    }

    // 👤 是否本人
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 🏪 是否店家成員
    function isShopMember(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid));
    }

    // 🏪 是否店主
    function isShopOwner(shopId) {
      return isShopMember(shopId)
        && get(/databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)).data.role == 'owner';
    }

    // 👤 會員帳號
    match /users/{uid} {
      allow read: if isSelf(uid) || isRootAdmin();
      allow create, update: if isSelf(uid) || isRootAdmin();
      allow delete: if false;
            // 🔔 使用者 FCM 推播 Token
      match /fcm_tokens/{tokenId} {
        allow read: if isSelf(uid) || isRootAdmin();

        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token == tokenId;

        allow delete: if isSelf(uid) || isRootAdmin();
      }

      // 📜 個人條款同意紀錄
      match /policy_acceptances/{shopId} {
  allow read: if isSelf(uid) || isRootAdmin();
  allow create, update: if isSelf(uid) || isRootAdmin();
  allow delete: if false;
}
    }

    // 👤 會員資料
match /user_profiles/{uid} {
  allow read: if isSelf(uid) || isRootAdmin();
  allow create: if isSelf(uid) || isRootAdmin();
  allow update: if isSelf(uid) || isRootAdmin();
  allow delete: if false;

      // 🐾 寵物資料
match /pets/{petId} {
  allow read: if isSelf(uid) || isRootAdmin();

  allow create, update, delete: if isSelf(uid) || isRootAdmin();
}
    }

    // 🏪 店家成員根集合
match /shop_members/{memberId} {

 allow read: if signedIn() &&
  (
    isRootAdmin() ||

    resource.data.uid == request.auth.uid ||

    (
      resource.data.shopId is string &&
      isShopMember(resource.data.shopId)
    )
  );
  // 建立店家成員：
  // 1. 平台最高權限可建立
  // 2. 店主可建立自己店家的成員
  // 3. 受邀員工只能建立「自己的」成員資料
 allow create: if signedIn() &&
  (
    isRootAdmin() ||

    (
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.role == 'owner' &&
      request.resource.data.shopId is string &&
      memberId == request.resource.data.shopId + '_' + request.auth.uid &&
      getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerUid == request.auth.uid
    ) ||

    (
      request.resource.data.shopId is string &&
      isShopOwner(request.resource.data.shopId)
    ) ||

    (
      request.resource.data.shopId is string &&
      request.resource.data.uid == request.auth.uid &&
      exists(/databases/$(database)/documents/shop_member_invites/$(request.resource.data.shopId + '_' + request.auth.uid))
    )
  );

  allow update, delete: if isRootAdmin() ||
    (
      resource.data.shopId is string &&
      isShopOwner(resource.data.shopId)
    );
}

    // ✉️ 員工邀請
match /shop_member_invites/{inviteId} {
  allow read: if signedIn();

  allow create: if signedIn() &&
    (
      isRootAdmin() ||
      (
        request.resource.data.shopId is string &&
        isShopOwner(request.resource.data.shopId)
      )
    );

  allow update, delete: if signedIn() &&
    (
      isRootAdmin() ||
      (
        resource.data.shopId is string &&
        isShopOwner(resource.data.shopId)
      )
    );
}

    // 🏪 店家資料
    match /shops/{shopId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isRootAdmin()
  ||
  (
    isShopMember(shopId)
    &&
    request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'updatedAt',

     'businessHours',
'openTime',
'closeTime',
'closedDays',
'isOpen',
'bookingEnabled',
'description',
'serviceTypes',
'isPublic',

'enabledModules',
'lockedModule',

'totalRooms',
'cleaningRooms',
'maintenanceRooms',
'maxAdvanceBookingDays',
'defaultPricePerNight',

'blockedDates',
'specialPrices',

      'banners',
      'coverUrl',
      'logoUrl',
      'platformHomeCoverUrl',
      'platformHomeLogoUrl',
      'environmentIntro',

      'fbUrl',
      'igUrl',
      'lineUrl',

      'showAnnouncementSection',
      'showFaqSection',
      'showTaxId',
      'externalLinksEnabled',

      'bankName',
      'accountName',
      'accountNumber',
      'paymentMethods',
      'depositEnabled',
      'depositType',
      'depositValue',
      'depositAmount',
      'depositBase',
      'depositExpireHours',

      'blockedDates',
      'blockedDateReasons',
      'specialPrices',
      'defaultPricePerNight'
    ])
  );
      allow delete: if false;

      // 🏪 店家子成員
      match /shop_members/{uid} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update, delete: if isShopOwner(shopId) || isRootAdmin();
      }

      // 👤 店家會員
match /members/{uid} {
  allow read: if isSelf(uid) || isShopMember(shopId) || isRootAdmin();

  allow create: if isSelf(uid);

  allow update: if isSelf(uid) || isShopMember(shopId) || isRootAdmin();

  allow delete: if false;
}

      // 🛏 房型
      match /room_types/{roomTypeId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 🚪 房間
      match /rooms/{roomId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }


// 📅 房務日曆
match /room_calendar/{calendarId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}
      // ➕ 加購
      match /addons/{addonId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 📜 店家條款
      match /policies/{policyId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }
      // 📢 店家公告
match /announcements/{announcementId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}

// ❓ 常見問題
match /faqs/{faqId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}

      // 📜 條款版本
      match /policy_versions/{versionId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 📜 店家條款同意紀錄
      match /policy_acceptances/{acceptanceId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

   // 📝 操作紀錄
match /action_logs/{logId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin() ||

      (
        request.resource.data.operatorUid == request.auth.uid &&
        request.resource.data.shopId is string &&
        request.resource.data.type == 'booking_cancelled'
      )
    );

  allow update, delete: if false;
}

    // 🔗 會員綁定 / 合併申請
match /member_link_requests/{requestId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin()
    );

 allow update: if signedIn() &&
  (
    isShopMember(resource.data.shopId) ||
    isRootAdmin()
  );
  allow delete: if false;
}

// 🗑️ 帳號刪除申請
match /account_delete_requests/{requestId} {

  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == 'pending';

  allow read: if signedIn()
    && (
      isRootAdmin()
      || resource.data.uid == request.auth.uid
    );

  allow update, delete: if isRootAdmin();
}

  match /booking_counters/{shopId} {
  allow read: if isShopMember(shopId) || isRootAdmin();

  allow create, update: if signedIn()
    && (
      isShopMember(shopId) ||
      isRootAdmin() ||
      (
        request.resource.data.keys().hasOnly([
          'current',
          'updatedAt'
        ])
        && request.resource.data.current is int
        && (
          !exists(/databases/$(database)/documents/booking_counters/$(shopId)) ||
          request.resource.data.current ==
            resource.data.current + 1
        )
      )
    );

  allow delete: if false;
}
    // 📊 退房報表
match /reports/{reportId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin()
    );

  allow update, delete: if false;
}

   // 📦 訂單
match /bookings/{bookingId} {

  allow read: if signedIn() &&
  (
    get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId
      == request.auth.uid
    ||
    isShopMember(
      get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
    )
    ||
    isRootAdmin()
  );

  allow create: if signedIn()
  &&
  request.resource.data.userId == request.auth.uid
  &&
  request.resource.data.shopId is string
  &&
  request.resource.data.status == 'pending'
  &&
  request.resource.data.createdAt == request.time;

  allow update: if signedIn() &&
  (
    isShopMember(resource.data.shopId) ||
    isRootAdmin() ||

    (
      resource.data.userId == request.auth.uid &&
      request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'status',
        'cancelReason',
        'cancelBy',
        'cancelledAt',
        'updatedAt',
        'transferImageUrl',
        'transferLast5',
        'depositStatus',
        'depositSubmittedAt',
        'depositExpired',
'assignStatus'
      ])
    )
  );

allow delete: if false;

  match /messages/{messageId} {

    allow read: if signedIn() &&
  (
    get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId
      == request.auth.uid
    ||
    isShopMember(
      get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
    )
    ||
    isRootAdmin()
  );

    allow create: if signedIn()
      &&
      request.resource.data.senderId == request.auth.uid
      &&
      (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId
          == request.auth.uid
        ||
        isShopMember(
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
        )
        ||
        isRootAdmin()
      );

    allow update, delete: if false;
  }
}
       // 📮 店主 / 店家聯絡平台
    match /platform_contact_requests/{requestId} {
      allow read: if signedIn() &&
        (
          isRootAdmin() ||
          isShopMember(resource.data.shopId)
        );

      allow create: if signedIn() &&
        request.resource.data.source == 'shop_owner' &&
        request.resource.data.shopId is string &&
        isShopMember(request.resource.data.shopId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';

      allow update: if isRootAdmin();

      allow delete: if false;

            // 💬 聯絡平台對話紀錄
      match /messages/{messageId} {
        allow read: if signedIn() &&
          (
            isRootAdmin() ||
            isShopMember(get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.shopId)
          );

        allow create: if signedIn() &&
  get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.status != 'closed' &&
  (
    (
      isRootAdmin() &&
      request.resource.data.senderType == 'platform'
    ) ||
    (
      request.resource.data.senderType == 'shop_owner' &&
      isShopMember(get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.shopId)
    )
  ) &&
  request.resource.data.senderUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

// 📨 店家重要資料修改申請
match /shop_change_requests/{requestId} {

  allow read: if signedIn() &&
    (
      isRootAdmin() ||
      (
        resource.data.shopId is string &&
        isShopMember(resource.data.shopId)
      )
    );

  allow create: if signedIn() &&
    (
      request.resource.data.shopId is string &&
      isShopMember(request.resource.data.shopId)
    );

  allow update: if isRootAdmin();

  allow delete: if isRootAdmin();
}

    // 📜 平台條款
   match /platform_policies/{policyId} {
  allow read: if true;
  allow create, update, delete: if isRootAdmin();

  match /versions/{versionId} {
    allow read: if true;
    allow create, update, delete: if isRootAdmin();
  }
}

// 🔢 平台流水號計數器
match /platform_counters/{counterId} {
  allow read: if isRootAdmin() || (signedIn() && counterId == 'shops');

  allow create, update: if signedIn()
    && counterId == 'shops'
    && request.resource.data.keys().hasOnly([
      'current',
      'updatedAt'
    ])
    && request.resource.data.current is int
    && (
      !exists(/databases/$(database)/documents/platform_counters/$(counterId)) ||
      request.resource.data.current ==
        resource.data.current + 1
    );

  allow delete: if isRootAdmin();
}

// 🎟 激活碼
match /activation_codes/{codeId} {

  // 登入後可查詢激活碼
  allow read: if signedIn();

  // 只有平台可建立 / 刪除激活碼
  allow create, delete: if isRootAdmin();

  // 平台可管理；一般使用者只能在創店時更新使用紀錄欄位
  allow update: if isRootAdmin()
    ||
    (
      signedIn()
      &&
      request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'usedCount',
        'usedShopIds',
        'usedByUids',
        'lastUsedAt',
        'updatedAt',
      ])
      &&
(
  request.resource.data.usedCount == resource.data.usedCount + 1
  ||
  (
    !('usedCount' in resource.data.keys())
    &&
    request.resource.data.usedCount == 1
  )
)
    );

  // 🎟 激活碼使用紀錄
  match /usage_logs/{logId} {
    allow read: if isRootAdmin();

    allow create: if signedIn()
      &&
      request.resource.data.usedByUid == request.auth.uid
      &&
      request.resource.data.shopId == logId;

    allow update, delete: if isRootAdmin();
  }
}
    // 👑 平台管理員
    match /platform_admins/{adminUid} {
      allow read, write: if isRootAdmin();
    }

    // 📜 平台條款版本
    match /platform_policy_versions/{versionId} {
      allow read, write: if isRootAdmin();
    }

    // 🔔 平台通知
match /shop_notifications/{notificationId} {
  allow read: if signedIn() &&
    (
      isRootAdmin() ||
      isShopMember(resource.data.shopId)
    );

  allow create, delete: if isRootAdmin();

allow update: if
  isRootAdmin()
  ||
  (
    isShopMember(resource.data.shopId)
    &&
    request.resource.data.shopId == resource.data.shopId
    &&
    request.resource.data.title == resource.data.title
    &&
    request.resource.data.content == resource.data.content
    &&
    request.resource.data.type == resource.data.type
    &&
    request.resource.data.createdAt == resource.data.createdAt
  );
}
    // 🚫 其他全部拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}