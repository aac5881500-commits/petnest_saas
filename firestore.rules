rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 登入判斷
    function signedIn() {
      return request.auth != null;
    }

   // 👑 PetNest 永久根管理員
// 功能：最高復原權限固定於後端規則，不依賴 platform_users 文件。
function isRootAdmin() {
  return signedIn()
    && request.auth.uid == '7FNrECQeqAca9Vu8lBBzTSdcJcg1';
}

// 👤 是否為已啟用的平台人員
// 功能：確認登入者在 platform_users 中存在，且帳號已啟用。
function isEnabledPlatformUser() {
  return signedIn()
    && exists(
      /databases/$(database)/documents/platform_users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/platform_users/$(request.auth.uid)
    ).data.enabled == true;
}

// 🔑 是否具有指定平台權限
// 功能：根管理員直接通過；其他平台人員需具備指定權限。
function hasPlatformPermission(permission) {
  return isRootAdmin()
    || (
      isEnabledPlatformUser()
      && get(
        /databases/$(database)/documents/platform_users/$(request.auth.uid)
      ).data.permissions is list
      && get(
        /databases/$(database)/documents/platform_users/$(request.auth.uid)
      ).data.permissions.hasAny([permission])
    );
}


    // 👤 是否本人
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 🏪 是否店家成員
    function isShopMember(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid));
    }

    // 🏪 是否店主
    function isShopOwner(shopId) {
      return isShopMember(shopId)
        && get(/databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)).data.role == 'owner';
    }

    // 🏪 shops/{shopId}.ownerUid 後援（成員文件 id 不符時仍視為店主）
    function isShopOwnerUid(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }
 // 🎁 是否可以管理實體商品核銷
function canManagePointRedemptions(shopId) {
  return signedIn()
    && exists(
      /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
    )
    && (
      get(
        /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
      ).data.role == 'owner'

      || (
        get(
          /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
        ).data.permissions is map

        && get(
          /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
        ).data.permissions.get(
          'manage_point_redemptions',
          false
        ) == true
      )

      || (
        (
          !(
            get(
              /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
            ).data.permissions is map
          )

          || !get(
            /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
          ).data.permissions.keys().hasAny([
            'manage_point_redemptions'
          ])
        )

        && get(
          /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
        ).data.role in [
          'manager',
          'staff'
        ]
      )
    );
}

function isShopCustomer(shopId) {
  return signedIn()
    && exists(
      /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)
    );
}

function shopMemberData(shopId) {
  return get(
    /databases/$(database)/documents/shop_members/$(shopId + '_' + request.auth.uid)
  ).data;
}

function canViewInventory(shopId) {
  return isRootAdmin()
    || (
      isShopMember(shopId)
      && (
        shopMemberData(shopId).role == 'owner'
        || (
          shopMemberData(shopId).permissions is map
          && (
            shopMemberData(shopId).permissions.get('view_inventory', false) == true
            || shopMemberData(shopId).permissions.get('manage_inventory', false) == true
          )
        )
        || (
          (
            !(shopMemberData(shopId).permissions is map)
            || !shopMemberData(shopId).permissions.keys().hasAny(['view_inventory'])
          )
          && shopMemberData(shopId).role in ['manager', 'staff']
        )
      )
    );
}

function canManageInventory(shopId) {
  return isRootAdmin()
    || isShopOwner(shopId)
    || (
      isShopMember(shopId)
      && shopMemberData(shopId).permissions is map
      && shopMemberData(shopId).permissions.get('manage_inventory', false) == true
    );
}

function hasShopPermissionKey(shopId, key) {
  return isRootAdmin()
    || isShopOwner(shopId)
    || (
      isShopMember(shopId)
      && shopMemberData(shopId).permissions is map
      && shopMemberData(shopId).permissions.get(key, false) == true
    );
}

function canViewStoreOrders(shopId) {
  return hasShopPermissionKey(shopId, 'view_store_orders')
    || hasShopPermissionKey(shopId, 'manage_store_orders');
}

function canManageStoreProducts(shopId) {
  return hasShopPermissionKey(shopId, 'manage_store_products');
}

function canManageStoreOrders(shopId) {
  return hasShopPermissionKey(shopId, 'manage_store_orders');
}

function canManageStoreSettings(shopId) {
  return hasShopPermissionKey(shopId, 'manage_store_settings');
}

    // 👤 會員帳號
    match /users/{uid} {
      allow read: if isSelf(uid) || isRootAdmin() ||
  (
    signedIn()
    && resource.data.shopIds is list
    && resource.data.shopIds.hasAny([
      get(/databases/$(database)/documents/shop_members/$(resource.data.shopIds[0] + '_' + request.auth.uid)).data.shopId
    ])
  );
      allow create, update: if isSelf(uid) || isRootAdmin();
      allow delete: if false;
            // 🔔 使用者 FCM 推播 Token
match /fcm_tokens/{tokenId} {
  allow read: if isSelf(uid) || isRootAdmin();

  allow create, update: if isSelf(uid)
    && request.resource.data.keys().hasOnly([
      'token',
      'platform',
      'enabled',
      'createdAt',
      'updatedAt',
      'lastSeenAt'
    ])
    && request.resource.data.token == tokenId
    && request.resource.data.platform is string
    && request.resource.data.enabled is bool;

  allow delete: if isSelf(uid) || isRootAdmin();
}

      // 📜 個人條款同意紀錄
match /policy_acceptances/{shopId} {
  allow read: if isSelf(uid) || isRootAdmin() || isShopMember(shopId);
  allow create, update: if isSelf(uid) || isRootAdmin();
  allow delete: if false;
}
// 🔔 會員通知設定
match /notification_settings/{settingId} {

  allow read: if isSelf(uid) || isRootAdmin();

  allow create, update: if isSelf(uid) || isRootAdmin();

  allow delete: if false;
}
    }

    // 👤 會員資料
match /user_profiles/{uid} {
  allow read: if isSelf(uid) || isRootAdmin();
  allow create: if
    isSelf(uid)
    || isRootAdmin()
    || (
      signedIn()
      && request.resource.data.createdFrom == 'admin'
      && request.resource.data.shopIds is list
      && request.resource.data.shopIds.size() == 1
      && request.resource.data.shopIds[0] is string
      && isShopMember(request.resource.data.shopIds[0])
    );
  allow update: if isSelf(uid) || isRootAdmin();
  allow delete: if false;

      // 🐾 寵物資料
match /pets/{petId} {
  allow read: if
    isSelf(uid)
    || isRootAdmin()
    || (
      resource.data.shopId is string
      && isShopMember(resource.data.shopId)
    );

  allow create, update, delete: if
    isSelf(uid)
    || isRootAdmin()
    || (
      signedIn()
      && request.resource.data.createdFrom == 'admin'
      && request.resource.data.shopId is string
      && isShopMember(request.resource.data.shopId)
    );
}
    }

    // 🏪 店家成員根集合
match /shop_members/{memberId} {

 allow read: if signedIn() &&
  (
    isRootAdmin() ||

    resource.data.uid == request.auth.uid ||

    (
      resource.data.shopId is string &&
      isShopMember(resource.data.shopId)
    )
  );
  // 建立店家成員：
  // 1. 平台最高權限可建立
  // 2. 店主可建立自己店家的成員
  // 3. 受邀員工只能建立「自己的」成員資料
 allow create: if signedIn() &&
  (
    isRootAdmin() ||

    (
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.role == 'owner' &&
      request.resource.data.shopId is string &&
      memberId == request.resource.data.shopId + '_' + request.auth.uid &&
      getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerUid == request.auth.uid
    ) ||

    (
      request.resource.data.shopId is string &&
      isShopOwner(request.resource.data.shopId)
    ) ||

   (
  request.resource.data.shopId is string &&
  request.resource.data.uid == request.auth.uid &&
  request.resource.data.emailKey is string &&
  exists(/databases/$(database)/documents/shop_member_invites/$(request.resource.data.shopId + '_' + request.resource.data.emailKey))
)
  );

  allow update, delete: if isRootAdmin() ||
    (
      resource.data.shopId is string &&
      isShopOwner(resource.data.shopId)
    );
}

    // ✉️ 員工邀請
match /shop_member_invites/{inviteId} {
  allow read: if signedIn();

  allow create: if signedIn() &&
    (
      isRootAdmin() ||
      (
        request.resource.data.shopId is string &&
        isShopOwner(request.resource.data.shopId)
      )
    );

 allow update, delete: if signedIn() &&
  (
    isRootAdmin() ||
    (
      resource.data.shopId is string &&
      isShopOwner(resource.data.shopId)
    )
  );

allow update: if signedIn() &&
  request.resource.data.status == 'accepted' &&
  resource.data.status == 'pending' &&
  resource.data.emailKey == request.auth.token.email.lower();
}

    // 🏪 店家資料
    match /shops/{shopId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isRootAdmin()
  ||
  (
    isShopMember(shopId)
    &&
    request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'updatedAt',
'name',
'businessType',
'phone',
'address',
'city',
'district',
'licenseNumber',
'taxId',
     'businessHours',
'openTime',
'closeTime',
'closedDays',
'isOpen',
'bookingEnabled',
'daycareEnabled',
'description',
'serviceTypes',
'isPublic',

'enabledModules',
'lockedModule',

'totalRooms',
'cleaningRooms',
'maintenanceRooms',
'housekeepingSetting',
'dailyCareSetting',
'maxAdvanceBookingDays',
'defaultPricePerNight',

'blockedDates',
'specialPrices',

      'banners',
      'coverUrl',
      'logoUrl',
      'platformHomeCoverUrl',
      'platformHomeLogoUrl',
      'environmentIntro',

      'aboutTitle',
      'aboutDescription',
      'aboutMessage',
      'aboutImageUrl',

      'fbUrl',
      'igUrl',
      'lineUrl',

'showAnnouncementSection',
'showFaqSection',
'showCameraSection',
'showTaxId',
'externalLinksEnabled',
'homeAppearance',
'floatingContactButton',
'storeChatEnabled',
      'bankName',
      'accountName',
      'accountNumber',
      'paymentMethods',
      'depositEnabled',
      'depositType',
      'depositValue',
      'depositAmount',
      'depositBase',
      'depositExpireHours',
'discountSetting',
      'blockedDates',
      'blockedDateReasons',
      'specialPrices',
      'defaultPricePerNight'
    ])
  );
      allow delete: if false;

      // 🏪 店家子成員
      match /shop_members/{uid} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update, delete: if isShopOwner(shopId) || isRootAdmin();
      }

      // 💬 店家聊天室：一個會員 × 一間店家 = 一個 thread
      match /chat_threads/{threadId} {
        function isCustomerThreadOwner() {
          return signedIn()
            && request.auth.uid == threadId
            && (
              resource == null
              || !('customerUid' in resource.data)
              || resource.data.customerUid == request.auth.uid
            );
        }

        function isCustomerCreatingOwnThread() {
          return signedIn()
            && request.auth.uid == threadId
            && request.resource.data.customerUid == request.auth.uid;
        }

        // 沿用商城既有 helper：成員文件或 shops.ownerUid，不另寫第三套 Owner 判定。
        function canAccessShopChat() {
          return isShopMember(shopId) || isShopOwnerUid(shopId);
        }

        allow read: if isRootAdmin()
          || canAccessShopChat()
          || isCustomerThreadOwner();

        allow create: if signedIn()
          && request.resource.data.shopId == shopId
          && request.resource.data.customerUid == threadId
          && (
            isCustomerCreatingOwnThread()
            || canAccessShopChat()
            || isRootAdmin()
          );

        allow update: if signedIn()
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.customerUid == resource.data.customerUid
          && (
            isCustomerThreadOwner()
            || canAccessShopChat()
            || isRootAdmin()
          );

        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isRootAdmin()
            || canAccessShopChat()
            || (signedIn() && request.auth.uid == threadId);

          allow create: if signedIn()
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.shopId == shopId
            && request.resource.data.threadId == threadId
            && (
              (
                request.resource.data.senderType == 'customer'
                && request.auth.uid == threadId
              )
              || (
                request.resource.data.senderType == 'shop'
                && canAccessShopChat()
              )
              || isRootAdmin()
            );

          allow update, delete: if false;
        }
      }

   // 👤 店家會員
match /members/{uid} {

  // 店家成員、平台管理員，或會員本人可以讀取
  allow read: if signedIn() &&
    (
      isShopMember(shopId)
      || isRootAdmin()
      || request.auth.uid == uid
    );

  // 店家可以建立會員
  // 一般會員只能建立自己的會員快取
  allow create: if signedIn() &&
    (
      isShopMember(shopId)
      || isRootAdmin()
      ||
      (
        request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.blacklisted == false
        && request.resource.data.isBlocked == false
      )
    );

  // 店家可完整更新
  // 一般會員只能更新自己的基本資料與同步欄位
  allow update: if signedIn() &&
    (
      isShopMember(shopId)
      || isRootAdmin()
      ||
      (
        request.auth.uid == uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
  'email',
  'name',
  'phone',
  'address',
  'emergencyContact',
  'petCount',
  'bookingCount',
  'updatedAt',
  'lastLoginAt',
  'lastBookingAt',

  'policyAccepted',
  'policyVersion',
  'policyTitle',
  'policyAcceptedAt',
  'policyAcceptedFrom'
])
      )
    );

  // 只有店家成員或平台管理員可以刪除
  allow delete: if signedIn() &&
    (
      isShopMember(shopId)
      || isRootAdmin()
    );

  // 🐾 店家會員底下的寵物快取
  match /pets/{petId} {

    allow read: if signedIn() &&
      (
        isShopMember(shopId)
        || isRootAdmin()
        || request.auth.uid == uid
      );

    allow create, update: if signedIn() &&
      (
        isShopMember(shopId)
        || isRootAdmin()
        || request.auth.uid == uid
      );

    allow delete: if signedIn() &&
      (
        isShopMember(shopId)
        || isRootAdmin()
      );
  }
}

      // 🛏 房型
      match /room_types/{roomTypeId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 🚪 房間
      match /rooms/{roomId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 📡 設備管理：攝影機 / 溫度 / 濕度 / 感測器
match /devices/{deviceId} {
  allow read: if isShopMember(shopId) || isRootAdmin();

  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}


// 📅 房務日曆
match /room_calendar/{calendarId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}
      // ➕ 加購
      match /addons/{addonId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 🔺 特殊日期加價
// 功能：
// 1. 店家成員與平台管理員可以查看、建立、修改、刪除全部設定
// 2. 一般使用者只能讀取已啟用的特殊日期加價
// 3. 每筆設定可獨立控制是否允許 Campaign 與優惠券
match /special_date_surcharges/{surchargeId} {

  // 店家可看全部。
  // 一般使用者只可讀取已啟用設定。
  allow read: if
    isRootAdmin()
    || isShopMember(shopId)
    || resource.data.enabled == true;

  // 建立特殊日期加價
  allow create: if
    (isRootAdmin() || isShopMember(shopId))
    && request.resource.data.shopId == shopId
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.amountPerNight is int
    && request.resource.data.amountPerNight > 0
&& request.resource.data.enabled is bool
&& request.resource.data.allowCampaignDiscount is bool
&& request.resource.data.allowCoupon is bool
&& request.resource.data.roomTypeIds is list;

  // 修改特殊日期加價
  // 不允許把資料改到其他店家
  allow update: if
    (isRootAdmin() || isShopMember(shopId))
    && resource.data.shopId == shopId
    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.amountPerNight is int
    && request.resource.data.amountPerNight > 0
&& request.resource.data.enabled is bool
&& request.resource.data.allowCampaignDiscount is bool
&& request.resource.data.allowCoupon is bool
&& request.resource.data.roomTypeIds is list;
  // 店家可刪除設定。
  // 歷史訂單依 Booking 快照保存，不依賴目前設定。
  allow delete: if
    isRootAdmin()
    || isShopMember(shopId);
}

      // 🏷️ 自動優惠活動
// 功能：會員只能讀取已啟用活動，店家成員與平台管理員可完整管理
match /discount_campaigns/{campaignId} {

  // 店家成員與平台管理員可以查看全部活動
  // 一般使用者只能查看已啟用的活動
  allow read: if
    isRootAdmin()
    || isShopMember(shopId)
    || resource.data.enabled == true;

  // 建立優惠活動
  allow create: if
    (isRootAdmin() || isShopMember(shopId))
    && request.resource.data.shopId == shopId
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.type is string
    && request.resource.data.valueType is string
    && request.resource.data.applyTarget is string
    && request.resource.data.discountValue is number
    && request.resource.data.discountValue > 0
    && request.resource.data.enabled is bool
    && request.resource.data.minimumNights is int
    && request.resource.data.minimumNights >= 0
    && request.resource.data.minimumAmount is int
    && request.resource.data.minimumAmount >= 0
    && request.resource.data.maximumDiscountAmount is int
    && request.resource.data.maximumDiscountAmount >= 0
    && request.resource.data.memberUsageLimit is int
    && request.resource.data.memberUsageLimit >= 0
    && request.resource.data.totalUsageLimit is int
    && request.resource.data.totalUsageLimit >= 0
    && request.resource.data.usedCount == 0
    && request.resource.data.firstBookingOnly is bool
    && request.resource.data.allowCouponTogether is bool
    && request.resource.data.roomTypeIds is list;

  // 修改優惠活動
  // shopId、createdBy、createdAt 與 usedCount 不可由一般頁面任意更改
  allow update: if
    (isRootAdmin() || isShopMember(shopId))
    && resource.data.shopId == shopId
    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.usedCount == resource.data.usedCount
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.discountValue is number
    && request.resource.data.discountValue > 0
    && request.resource.data.enabled is bool
    && request.resource.data.minimumNights is int
    && request.resource.data.minimumNights >= 0
    && request.resource.data.minimumAmount is int
    && request.resource.data.minimumAmount >= 0
    && request.resource.data.maximumDiscountAmount is int
    && request.resource.data.maximumDiscountAmount >= 0
    && request.resource.data.memberUsageLimit is int
    && request.resource.data.memberUsageLimit >= 0
    && request.resource.data.totalUsageLimit is int
    && request.resource.data.totalUsageLimit >= 0
    && request.resource.data.firstBookingOnly is bool
    && request.resource.data.allowCouponTogether is bool
    && request.resource.data.roomTypeIds is list;

  // 目前尚未接訂單使用紀錄，因此先允許店家刪除
  allow delete: if isRootAdmin() || isShopMember(shopId);
}

      // 🎟️ 會員持有優惠券
      // 功能：
      // 1. 店家成員與平台管理員可管理優惠券
      // 2. 一般會員只能查看屬於自己的優惠券
      // 3. 暫時不允許會員端自行建立或修改，避免竄改優惠內容
            // 🎫 店家優惠券模板
      // 功能：
      // 1. 店家建立優惠券母版
      // 2. 供手動發券、點數兌換與自動贈券共用
      // 3. 一般會員不可直接讀寫模板
      match /coupon_templates/{templateId} {

        // 只有平台管理員與店家成員可以查看
        allow read: if
          isRootAdmin()
          || isShopMember(shopId);

        // 建立優惠券模板
        allow create: if
          (isRootAdmin() || isShopMember(shopId))
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0

          && request.resource.data.type in [
            'fixedAmount',
            'percent',
            'freeStay',
            'freeService'
          ]

          && request.resource.data.applyTarget in [
            'room',
            'roomAndPet',
            'total',
            'service'
          ]
          && (
  (
    request.resource.data.type in [
      'fixedAmount',
      'percent'
    ]
    && request.resource.data.applyTarget in [
      'room',
      'roomAndPet',
      'total'
    ]
  )

  ||

  (
    request.resource.data.type == 'freeStay'
    && request.resource.data.applyTarget == 'room'
  )

  ||

  (
    request.resource.data.type == 'freeService'
    && request.resource.data.applyTarget == 'service'
  )
)

          && request.resource.data.discountValue is number
          && request.resource.data.discountValue >= 0

          && request.resource.data.minimumAmount is int
          && request.resource.data.minimumAmount >= 0

          && request.resource.data.maximumDiscountAmount is int
          && request.resource.data.maximumDiscountAmount >= 0

          && request.resource.data.freeStayNights is int
          && request.resource.data.freeStayNights >= 0

          && request.resource.data.roomTypeIds is list

          && request.resource.data.validDays is int
          && request.resource.data.validDays >= 0

          && request.resource.data.usageLimit is int
          && request.resource.data.usageLimit > 0

          && request.resource.data.enabled is bool
          && request.resource.data.sortOrder is int

          && request.resource.data.createdBy is string
          && request.resource.data.updatedBy is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        // 修改優惠券模板
        // 不允許修改所屬店家、建立人與建立時間
        allow update: if
          (isRootAdmin() || isShopMember(shopId))
          && resource.data.shopId == shopId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt

          && request.resource.data.name is string
          && request.resource.data.name.size() > 0

          && request.resource.data.type in [
            'fixedAmount',
            'percent',
            'freeStay',
            'freeService'
          ]

          && request.resource.data.applyTarget in [
            'room',
            'roomAndPet',
            'total',
            'service'
          ]
          && (
  (
    request.resource.data.type in [
      'fixedAmount',
      'percent'
    ]
    && request.resource.data.applyTarget in [
      'room',
      'roomAndPet',
      'total'
    ]
  )

  ||

  (
    request.resource.data.type == 'freeStay'
    && request.resource.data.applyTarget == 'room'
  )

  ||

  (
    request.resource.data.type == 'freeService'
    && request.resource.data.applyTarget == 'service'
  )
)

          && request.resource.data.discountValue is number
          && request.resource.data.discountValue >= 0

          && request.resource.data.minimumAmount is int
          && request.resource.data.minimumAmount >= 0

          && request.resource.data.maximumDiscountAmount is int
          && request.resource.data.maximumDiscountAmount >= 0

          && request.resource.data.freeStayNights is int
          && request.resource.data.freeStayNights >= 0

          && request.resource.data.roomTypeIds is list

          && request.resource.data.validDays is int
          && request.resource.data.validDays >= 0

          && request.resource.data.usageLimit is int
          && request.resource.data.usageLimit > 0


          && request.resource.data.enabled is bool
          && request.resource.data.sortOrder is int

          && request.resource.data.updatedBy is string
          && request.resource.data.updatedAt is timestamp;

        // 刪除模板不會刪除會員已領取的優惠券
        allow delete: if
          isRootAdmin()
          || isShopMember(shopId);
      }
      match /member_coupons/{couponId} {

        // 店家成員與平台管理員可以查看全部優惠券
        // 一般會員只能查看自己的優惠券
        allow read: if
  isRootAdmin()
  || isShopMember(shopId)
  || (
    signedIn()
    && resource.data.shopId == shopId
    && resource.data.userId == request.auth.uid
  );

                // 店家成員與平台管理員可以手動發券。
        //
        // 一般會員只能透過點數兌換建立自己的優惠券，
        // 且優惠內容必須與兌換商品設定完全一致。
        allow create: if
          (
            (isRootAdmin() || isShopMember(shopId))

            && request.resource.data.shopId == shopId
            && request.resource.data.userId is string
            && request.resource.data.userId.size() > 0
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0

            && request.resource.data.type in [
              'fixedAmount',
              'percent',
              'freeStay',
              'freeService'
            ]

            && request.resource.data.applyTarget in [
              'room',
              'roomAndPet',
              'total',
              'service'
            ]
            && (
  (
    request.resource.data.type in [
      'fixedAmount',
      'percent'
    ]
    && request.resource.data.applyTarget in [
      'room',
      'roomAndPet',
      'total'
    ]
  )

  ||

  (
    request.resource.data.type == 'freeStay'
    && request.resource.data.applyTarget == 'room'
  )

  ||

  (
    request.resource.data.type == 'freeService'
    && request.resource.data.applyTarget == 'service'
  )
)

            && request.resource.data.source in [
              'manual',
              'pointsExchange'
            ]

            && request.resource.data.status == 'available'
            && request.resource.data.discountValue is number
            && request.resource.data.discountValue >= 0
            && request.resource.data.minimumAmount is int
            && request.resource.data.minimumAmount >= 0
            && request.resource.data.maximumDiscountAmount is int
            && request.resource.data.maximumDiscountAmount >= 0
            && request.resource.data.freeStayNights is int
            && request.resource.data.freeStayNights >= 0
            && request.resource.data.roomTypeIds is list
            && request.resource.data.usageLimit is int
            && request.resource.data.usageLimit > 0
            && request.resource.data.usedCount == 0
            && request.resource.data.pointsCost is int
            && request.resource.data.pointsCost >= 0
            && request.resource.data.usedBookingId == ''
          )

          ||

          (
            signedIn()

            // 優惠券必須屬於登入會員本人
            && request.resource.data.shopId == shopId
            && request.resource.data.userId == request.auth.uid

            // 會員只能建立點數兌換券
            && request.resource.data.source == 'pointsExchange'
            && request.resource.data.status == 'available'

            // 必須綁定兌換商品
            && request.resource.data.pointRewardId is string
            && request.resource.data.pointRewardId.size() > 0

            // 發券人必須是會員本人
            && request.resource.data.issuedBy == request.auth.uid
            && request.resource.data.issuedReason == '會員使用點數兌換'

            // 必須是尚未使用的新優惠券
            && request.resource.data.usedCount == 0
            && request.resource.data.usedBookingId == ''
            && request.resource.data.usedAt == null
            && request.resource.data.revokedBy == ''
            && request.resource.data.revokedReason == ''
            && request.resource.data.revokedAt == null

            // 兌換商品必須存在並且已開放
            && get(
              /databases/$(database)/documents/shops/$(shopId)
              /point_rewards/$(request.resource.data.pointRewardId)
            ).data.enabled == true

            // 優惠券內容必須與兌換商品一致
            && request.resource.data.name
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.name

            && request.resource.data.description
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.description

            && request.resource.data.type
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.couponType

            && request.resource.data.applyTarget
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.applyTarget

            && request.resource.data.discountValue
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.discountValue

            && request.resource.data.minimumAmount
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.minimumAmount

            && request.resource.data.maximumDiscountAmount
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.maximumDiscountAmount

            && request.resource.data.freeStayNights
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.freeStayNights

            && request.resource.data.serviceId
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.serviceId

            && request.resource.data.serviceName
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.serviceName

            && request.resource.data.roomTypeIds
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.roomTypeIds

            && request.resource.data.usageLimit
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.usageLimit

            && request.resource.data.pointsCost
              == get(
                /databases/$(database)/documents/shops/$(shopId)
                /point_rewards/$(request.resource.data.pointRewardId)
              ).data.pointsCost

            // 基本欄位格式檢查
            && request.resource.data.pointsCost is int
            && request.resource.data.pointsCost > 0
            && request.resource.data.usageLimit is int
            && request.resource.data.usageLimit > 0
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
          );

// 店家後台可執行核銷、退回與撤銷。
//
// 一般會員只能在建立自己的訂單後，
// 將自己的優惠券由 available 改成 reserved。
allow update: if
  (
    // 平台或店家人員更新
    (isRootAdmin() || isShopMember(shopId))

    && resource.data.shopId == shopId
    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.source == resource.data.source
    && request.resource.data.createdAt == resource.data.createdAt
  )

  ||

  (
    // 一般會員只能操作自己的優惠券
    signedIn()
    && resource.data.shopId == shopId
    && resource.data.userId == request.auth.uid

    // 優惠券目前必須尚未使用
    && resource.data.status == 'available'
    && resource.data.usedBookingId == ''
    && resource.data.usedAt == null

    // 只能改成訂單保留狀態
    && request.resource.data.status == 'reserved'
    && request.resource.data.usedBookingId is string
    && request.resource.data.usedBookingId.size() > 0
    && request.resource.data.usedAt == null

    // 對應的訂單必須存在
    && exists(
      /databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)
    )

    // 必須是登入會員自己的訂單
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)
    ).data.userId == request.auth.uid

    // 訂單與優惠券必須屬於同一家店
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)
    ).data.shopId == shopId

    // 訂單必須確實使用這張優惠券
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.usedBookingId)
    ).data.couponId == couponId

    // 會員只能修改以下四個欄位
    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'status',
        'usedBookingId',
        'usedAt',
        'updatedAt'
      ])

    // 重要不可變欄位必須保留
    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.source == resource.data.source
    && request.resource.data.createdAt == resource.data.createdAt
  );

        // 優惠券需保留使用紀錄，不允許直接刪除
        allow delete: if false;
      }

            // 🎁 點數兌換商品
      // 功能：
      // 1. 店家成員與平台管理員可完整管理
      // 2. 一般會員只能查看已開啟的兌換商品
      // 3. 會員端不可自行建立或修改商品設定
      match /point_rewards/{rewardId} {

        // 店家可查看全部商品
        // 一般會員只能查看已啟用商品
        allow read: if
          isRootAdmin()
          || isShopMember(shopId)
          || resource.data.enabled == true;

        // 只有店家成員或平台管理員可以新增
        allow create: if
          (isRootAdmin() || isShopMember(shopId))
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.pointsCost is int
          && request.resource.data.pointsCost > 0
          && request.resource.data.couponType in [
            'fixedAmount',
            'percent',
            'freeStay',
            'freeService'
          ]
          && request.resource.data.applyTarget in [
            'room',
            'roomAndPet',
            'total',
            'service'
          ]
          && (
  (
    request.resource.data.couponType in [
      'fixedAmount',
      'percent'
    ]
    && request.resource.data.applyTarget in [
      'room',
      'roomAndPet',
      'total'
    ]
  )

  ||

  (
    request.resource.data.couponType == 'freeStay'
    && request.resource.data.applyTarget == 'room'
  )

  ||

  (
    request.resource.data.couponType == 'freeService'
    && request.resource.data.applyTarget == 'service'
  )
)
          && request.resource.data.discountValue is number
          && request.resource.data.discountValue >= 0
          && request.resource.data.minimumAmount is int
          && request.resource.data.minimumAmount >= 0
          && request.resource.data.maximumDiscountAmount is int
          && request.resource.data.maximumDiscountAmount >= 0
          && request.resource.data.freeStayNights is int
          && request.resource.data.freeStayNights >= 0
          && request.resource.data.roomTypeIds is list
          && request.resource.data.validDays is int
          && request.resource.data.validDays >= 0
          && request.resource.data.usageLimit is int
          && request.resource.data.usageLimit > 0
          && request.resource.data.exchangeLimitPerMember is int
          && request.resource.data.exchangeLimitPerMember >= 0
          && request.resource.data.totalExchangeLimit is int
          && request.resource.data.totalExchangeLimit >= 0
          && request.resource.data.exchangedCount == 0
          && request.resource.data.enabled is bool
          && request.resource.data.sortOrder is int
          && request.resource.data.createdBy == request.auth.uid;

                  // 店家可以修改商品內容。
        // shopId、createdBy、createdAt 與 exchangedCount 不可任意改動。
        //
        // 一般會員兌換時，只能將 exchangedCount 增加 1，
        // 不可修改商品的任何其他設定。
        allow update: if
          (
            (isRootAdmin() || isShopMember(shopId))

            && resource.data.shopId == shopId
            && request.resource.data.shopId == resource.data.shopId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt

            // 店家編輯商品時，不可直接改兌換數量
            && request.resource.data.exchangedCount
              == resource.data.exchangedCount

            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.pointsCost is int
            && request.resource.data.pointsCost > 0

            && request.resource.data.couponType in [
              'fixedAmount',
              'percent',
              'freeStay',
              'freeService'
            ]

            && request.resource.data.applyTarget in [
              'room',
              'roomAndPet',
              'total',
              'service'
            ]
            && (
  (
    request.resource.data.couponType in [
      'fixedAmount',
      'percent'
    ]
    && request.resource.data.applyTarget in [
      'room',
      'roomAndPet',
      'total'
    ]
  )

  ||

  (
    request.resource.data.couponType == 'freeStay'
    && request.resource.data.applyTarget == 'room'
  )

  ||

  (
    request.resource.data.couponType == 'freeService'
    && request.resource.data.applyTarget == 'service'
  )
)

            && request.resource.data.discountValue is number
            && request.resource.data.discountValue >= 0
            && request.resource.data.minimumAmount is int
            && request.resource.data.minimumAmount >= 0
            && request.resource.data.maximumDiscountAmount is int
            && request.resource.data.maximumDiscountAmount >= 0
            && request.resource.data.freeStayNights is int
            && request.resource.data.freeStayNights >= 0
            && request.resource.data.roomTypeIds is list
            && request.resource.data.validDays is int
            && request.resource.data.validDays >= 0
            && request.resource.data.usageLimit is int
            && request.resource.data.usageLimit > 0
            && request.resource.data.exchangeLimitPerMember is int
            && request.resource.data.exchangeLimitPerMember >= 0
            && request.resource.data.totalExchangeLimit is int
            && request.resource.data.totalExchangeLimit >= 0
            && request.resource.data.enabled is bool
            && request.resource.data.sortOrder is int
          )

          ||

          (
            signedIn()

            // 商品必須已開啟
            && resource.data.enabled == true

            // 兌換點數必須有效
            && resource.data.pointsCost is int
            && resource.data.pointsCost > 0

            // 每次只能增加一次兌換數量
            && request.resource.data.exchangedCount
              == resource.data.exchangedCount + 1

            // 有總兌換上限時，不可超過上限
            && (
              resource.data.totalExchangeLimit == 0
              || request.resource.data.exchangedCount
                <= resource.data.totalExchangeLimit
            )

            // 除 exchangedCount 與 updatedAt 外，
            // 商品的其他欄位全部不得修改
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'exchangedCount',
                'updatedAt'
              ])

                   && request.resource.data.updatedAt is timestamp
          )

          ||

          (
            // 店家取消兌換時，只允許將兌換總數減少 1
            (isRootAdmin() || isShopMember(shopId))

            && resource.data.shopId == shopId
            && request.resource.data.shopId
              == resource.data.shopId

            && resource.data.exchangedCount is int
            && resource.data.exchangedCount > 0

            && request.resource.data.exchangedCount
              == resource.data.exchangedCount - 1

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'exchangedCount',
                'updatedAt'
              ])

            && request.resource.data.updatedAt is timestamp
          );

        // 只有尚未有人兌換的商品可以刪除
        allow delete: if
          (isRootAdmin() || isShopMember(shopId))
          && resource.data.exchangedCount == 0;
                  // 👤 會員兌換次數紀錄
        // Firestore 路徑：
        // shops/{shopId}/point_rewards/{rewardId}/member_exchanges/{userId}
        match /member_exchanges/{userId} {

          // 店家與平台管理員可查看
          // 一般會員只能查看自己的兌換紀錄
          allow read: if
            isRootAdmin()
            || isShopMember(shopId)
            || isSelf(userId);

          // 一般會員只能建立自己的兌換紀錄
                    allow create: if
            isSelf(userId)
            && request.resource.data.shopId == shopId
            && request.resource.data.rewardId == rewardId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.exchangedCount == 1

            // 優惠券商品會記錄 lastCouponId；
            // 實體商品會記錄 lastRedemptionId。
            && request.resource.data.lastCouponId is string
            && request.resource.data.lastRedemptionId is string

            // 兩者至少必須有一個有效 ID
            && (
              request.resource.data.lastCouponId.size() > 0
              || request.resource.data.lastRedemptionId.size() > 0
            )

            && request.resource.data.lastExchangedAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.createdAt is timestamp;

                    // 一般會員兌換時增加 1；
          // 店家取消實體商品兌換時減少 1。
          allow update: if
            (
              isSelf(userId)

              && resource.data.shopId == shopId
              && resource.data.rewardId == rewardId
              && resource.data.userId == request.auth.uid

              && request.resource.data.shopId
                == resource.data.shopId
              && request.resource.data.rewardId
                == resource.data.rewardId
             && request.resource.data.userId
  == resource.data.userId

// 舊版兌換紀錄可能沒有 createdAt。
// 已有 createdAt 時必須保留原值；
// 沒有 createdAt 時，允許本次兌換補上一個時間戳。
&& request.resource.data.createdAt is timestamp
&& (
  !resource.data.keys().hasAny(['createdAt'])
  || request.resource.data.createdAt
    == resource.data.createdAt
)

&& request.resource.data.exchangedCount
  == resource.data.exchangedCount + 1

              && request.resource.data.lastCouponId is string
              && request.resource.data.lastRedemptionId is string

              && (
                request.resource.data.lastCouponId.size() > 0
                || request.resource.data.lastRedemptionId.size() > 0
              )

              && request.resource.data.lastExchangedAt is timestamp
              && request.resource.data.updatedAt is timestamp
            )

            ||

            (
              (isRootAdmin() || isShopMember(shopId))

              && resource.data.shopId == shopId
              && resource.data.rewardId == rewardId
              && resource.data.userId == userId

              && request.resource.data.shopId
                == resource.data.shopId
              && request.resource.data.rewardId
                == resource.data.rewardId
              && request.resource.data.userId
                == resource.data.userId
              && request.resource.data.createdAt
                == resource.data.createdAt

              && resource.data.exchangedCount is int
              && resource.data.exchangedCount > 0

              && request.resource.data.exchangedCount
                == resource.data.exchangedCount - 1

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'exchangedCount',
                  'updatedAt'
                ])

              && request.resource.data.updatedAt is timestamp
            );

          // 兌換次數紀錄不可刪除
          allow delete: if false;
        }
      }
            // ============================================================
      // 🎁 點數實體商品兌換紀錄
      // Firestore 路徑：
      // shops/{shopId}/point_redemptions/{redemptionId}
      // ============================================================
      match /point_redemptions/{redemptionId} {

        // 會員只能查看自己的兌換紀錄。
        // 店家成員與平台管理員可以查看店內全部紀錄。
        allow read: if
  isRootAdmin()
  || canManagePointRedemptions(shopId)
  || (
    signedIn()
    && resource.data.shopId == shopId
    && resource.data.userId == request.auth.uid
  );

        // 會員使用點數兌換實體商品時，
        // 只能替自己建立「待領取」紀錄。
        allow create: if
          signedIn()

          // 必須是登入會員自己的兌換紀錄
          && request.resource.data.shopId == shopId
          && request.resource.data.userId == request.auth.uid

          // 必須綁定點數商品
          && request.resource.data.rewardId is string
          && request.resource.data.rewardId.size() > 0

          // 商品必須存在、已啟用，而且是實體商品
          && get(
            /databases/$(database)/documents/shops/$(shopId)
            /point_rewards/$(request.resource.data.rewardId)
          ).data.enabled == true

          && get(
            /databases/$(database)/documents/shops/$(shopId)
            /point_rewards/$(request.resource.data.rewardId)
          ).data.fulfillmentType == 'physicalProduct'

          // 商品名稱與扣除點數必須符合商城設定
          && request.resource.data.rewardName
            == get(
              /databases/$(database)/documents/shops/$(shopId)
              /point_rewards/$(request.resource.data.rewardId)
            ).data.name

          && request.resource.data.pointsCost
            == get(
              /databases/$(database)/documents/shops/$(shopId)
              /point_rewards/$(request.resource.data.rewardId)
            ).data.pointsCost

          // 點數計算必須正確
          && request.resource.data.pointsCost is int
          && request.resource.data.pointsCost > 0
          && request.resource.data.balanceBefore is int
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.balanceAfter
            == request.resource.data.balanceBefore
              - request.resource.data.pointsCost

          // 新建立紀錄只能是待領取
          && request.resource.data.status == 'pendingPickup'

          // 必須產生領取碼
          && request.resource.data.pickupCode is string
          && request.resource.data.pickupCode.size() > 0

          // 新紀錄不得直接變成已領取、取消或已退點
          && request.resource.data.pickedUpBy == ''
          && request.resource.data.pickedUpAt == null
          && request.resource.data.cancelledBy == ''
          && request.resource.data.cancelledAt == null
          && request.resource.data.cancelReason == ''
          && request.resource.data.pointsRefunded == false
          && request.resource.data.pointsRefundedBy == ''
          && request.resource.data.pointsRefundedAt == null

          // 時間欄位
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;

        // 只有店家成員與平台管理員可以：
        // 1. 核銷並交付商品
        // 2. 取消兌換
        // 3. 標記過期
        allow update: if
  (isRootAdmin() || canManagePointRedemptions(shopId))

          // 不可更換店家與會員
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.userId == resource.data.userId

          // 不可修改原始商品及扣點資料
          && request.resource.data.rewardId == resource.data.rewardId
          && request.resource.data.rewardName == resource.data.rewardName
          && request.resource.data.pointsCost == resource.data.pointsCost
          && request.resource.data.balanceBefore == resource.data.balanceBefore
          && request.resource.data.balanceAfter == resource.data.balanceAfter
          && request.resource.data.pickupCode == resource.data.pickupCode
          && request.resource.data.createdAt == resource.data.createdAt

          // 狀態只能使用合法值
          && request.resource.data.status in [
            'pendingPickup',
            'pickedUp',
            'cancelled',
            'expired'
          ]

          && request.resource.data.updatedAt is timestamp;

        // 核銷與點數帳務紀錄不能直接刪除
        allow delete: if false;
      }
           // 🪙 會員點數
      match /member_points/{userId} {

        // 店家成員、平台管理員及會員本人可以查看
        allow read: if
          isRootAdmin()
          || isShopMember(shopId)
          || isSelf(userId);

        // 點數帳戶只能由店家成員或平台管理員建立
        allow create: if
          isRootAdmin()
          || isShopMember(shopId);

        // 店家成員與平台管理員可以正常修改
        //
        // 會員本人只能執行點數兌換扣點：
        // 1. currentPoints 只能減少
        // 2. totalUsedPoints 必須增加相同數量
        // 3. 其他累積點數不可被修改
        allow update: if
          isRootAdmin()
          || isShopMember(shopId)
          || (
            isSelf(userId)

            && resource.data.shopId == shopId
            && resource.data.userId == request.auth.uid

            && request.resource.data.shopId
              == resource.data.shopId
            && request.resource.data.userId
              == resource.data.userId
            && request.resource.data.createdAt
              == resource.data.createdAt

            && request.resource.data.currentPoints >= 0
            && request.resource.data.currentPoints
              < resource.data.currentPoints

            && request.resource.data.totalUsedPoints
              == resource.data.totalUsedPoints
                + (
                  resource.data.currentPoints
                  - request.resource.data.currentPoints
                )

            && request.resource.data.totalEarnedPoints
              == resource.data.totalEarnedPoints
            && request.resource.data.totalExpiredPoints
              == resource.data.totalExpiredPoints

            && request.resource.data.lastEarnedAt
              == resource.data.lastEarnedAt
            && request.resource.data.lastExpiredAt
              == resource.data.lastExpiredAt

            && request.resource.data.lastUsedAt is timestamp
            && request.resource.data.updatedAt is timestamp
          );

        // 點數帳戶不允許直接刪除
        allow delete: if false;
      }

      // 🧾 點數流水
      match /member_point_logs/{logId} {

        // 店家成員、平台管理員，以及會員本人可以查看
        allow read: if
          isRootAdmin()
          || isShopMember(shopId)
          || (
            signedIn()
            && resource.data.userId == request.auth.uid
          );

        // 店家成員與平台管理員可以建立一般流水。
        //
        // 會員本人只能建立「點數兌換」扣點流水。
        allow create: if
          isRootAdmin()
          || isShopMember(shopId)
          || (
            signedIn()

            // 限制只能寫入既定欄位
                       && request.resource.data.keys().hasOnly([
              'shopId',
              'userId',
              'type',
              'points',
              'balanceBefore',
              'balanceAfter',
              'reason',
              'operatorUid',
              'sourceId',
              'bookingId',
              'rewardId',
              'couponId',
              'redemptionId',
              'expireAt',
              'note',
              'createdAt'
            ])

            // 必須是本人自己的流水
            && request.resource.data.shopId == shopId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.operatorUid == request.auth.uid

            // 會員只能建立兌換扣點紀錄
            && request.resource.data.type == 'rewardExchange'
            && request.resource.data.points is int
            && request.resource.data.points < 0

            // 扣點後餘額不可小於零
            && request.resource.data.balanceBefore is int
            && request.resource.data.balanceAfter is int
            && request.resource.data.balanceAfter >= 0

            // points 為負數，所以：
            // balanceAfter = balanceBefore + points
            && request.resource.data.balanceAfter
              == request.resource.data.balanceBefore
                + request.resource.data.points

                        // 兌換時必須綁定點數商品
            && request.resource.data.rewardId is string
            && request.resource.data.rewardId.size() > 0
            && request.resource.data.sourceId
              == request.resource.data.rewardId

            // 優惠券商品使用 couponId；
            // 實體商品使用 redemptionId。
            && request.resource.data.couponId is string
            && request.resource.data.redemptionId is string

            // 兩個欄位至少要有一個有效 ID
            && (
              request.resource.data.couponId.size() > 0
              || request.resource.data.redemptionId.size() > 0
            )

            // 點數兌換不綁訂單與點數到期日
            && request.resource.data.bookingId == ''
            && request.resource.data.expireAt == null

            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.note is string
            && request.resource.data.createdAt is timestamp
          );

        // 流水建立後不可修改或刪除
        allow update, delete: if false;
      }

            // 🪙 店家點數制度設定
      // Firestore 路徑：
      // shops/{shopId}/settings/points
      match /settings/{settingId} {

               // 點數設定可供已登入會員讀取
        // 只有店家成員與平台管理員可以修改
        allow read: if
          settingId == 'points'
          && signedIn();

               // 第一次建立點數設定
        allow create: if
          settingId == 'points'
          && (
            isRootAdmin()
            || isShopMember(shopId)
          )
          && request.resource.data.shopId == shopId
          && request.resource.data.enabled is bool

          // 發點計算方式
          && request.resource.data.calculationType is string
          && (
            request.resource.data.calculationType == 'amount'
            || request.resource.data.calculationType == 'night'
          )

          // 依消費金額發點設定
          && request.resource.data.amountPerPoint is int
          && request.resource.data.amountPerPoint > 0

          // 依住宿晚數發點設定
          && request.resource.data.pointsPerNight is int
          && request.resource.data.pointsPerNight > 0

          && request.resource.data.minimumOrderAmount is int
          && request.resource.data.minimumOrderAmount >= 0
          && request.resource.data.maximumPointsPerBooking is int
          && request.resource.data.maximumPointsPerBooking >= 0
          && request.resource.data.pointExpireDays is int
          && request.resource.data.pointExpireDays >= 0
          && request.resource.data.issueAfterCompleted is bool
          && request.resource.data.allowManualAdjustment is bool
          && request.resource.data.allowPointsExchange is bool
          && request.resource.data.pointName is string
          && request.resource.data.pointName.size() > 0
          && request.resource.data.pointName.size() <= 10
          && request.resource.data.description is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;

        // 修改既有點數設定
        allow update: if
          settingId == 'points'
          && (
            isRootAdmin()
            || isShopMember(shopId)
          )
          && resource.data.shopId == shopId
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.enabled is bool

          // 發點計算方式
          && request.resource.data.calculationType is string
          && (
            request.resource.data.calculationType == 'amount'
            || request.resource.data.calculationType == 'night'
          )

          // 依消費金額發點設定
          && request.resource.data.amountPerPoint is int
          && request.resource.data.amountPerPoint > 0

          // 依住宿晚數發點設定
          && request.resource.data.pointsPerNight is int
          && request.resource.data.pointsPerNight > 0

          && request.resource.data.minimumOrderAmount is int
          && request.resource.data.minimumOrderAmount >= 0
          && request.resource.data.maximumPointsPerBooking is int
          && request.resource.data.maximumPointsPerBooking >= 0
          && request.resource.data.pointExpireDays is int
          && request.resource.data.pointExpireDays >= 0
          && request.resource.data.issueAfterCompleted is bool
          && request.resource.data.allowManualAdjustment is bool
          && request.resource.data.allowPointsExchange is bool
          && request.resource.data.pointName is string
          && request.resource.data.pointName.size() > 0
          && request.resource.data.pointName.size() <= 10
          && request.resource.data.description is string;

        // 點數制度設定不直接刪除
        allow delete: if false;
      }

      // 📜 店家條款
      match /policies/{policyId} {
        allow read: if true;
        allow create, update: if isShopMember(shopId) || isRootAdmin();
        allow delete: if false;
      }

      match /daycare_settings/{docId} {
        allow read: if true;
        allow create, update: if isShopMember(shopId) || isRootAdmin();
        allow delete: if false;
      }

      match /daycare_date_overrides/{dateId} {
        allow read: if true;
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      match /daycare_policy_versions/{versionId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update: if isShopMember(shopId) || isRootAdmin();
        allow delete: if false;
      }

      match /daycare_ops/{opId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update, delete: if false;
      }

      match /room_occupancies/{occId} {
        allow read: if isShopMember(shopId) || isRootAdmin() || signedIn();
        allow create, update, delete: if false;
      }
      // 📢 店家公告
match /announcements/{announcementId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}

// ❓ 常見問題
match /faqs/{faqId} {
  allow read: if true;
  allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
}

      // 📜 條款版本
      match /policy_versions/{versionId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create, update, delete: if isShopMember(shopId) || isRootAdmin();
      }

      // 📜 店家條款同意紀錄
      match /policy_acceptances/{acceptanceId} {
        allow read: if isShopMember(shopId) || isRootAdmin();
        allow create: if signedIn();
        allow update, delete: if false;
      }

      // 📦 中央庫存品項
      // 功能：店家彼此隔離。完整 document（含成本、安全庫存、批次等）
      // 僅 Root Admin、店主、以及有庫存檢視／管理權限的店家成員可讀寫。
      // 一般店家 Customer 不可 read / create / update / delete。
      // 點數兌換、住宿加購庫存改由 Functions Admin SDK 處理。
      // 不要為了前台預約把 isShopCustomer 加回此處。
      match /inventory_items/{itemId} {
        allow read: if
          isRootAdmin()
          || canViewInventory(shopId)
          || isShopMember(shopId);

        allow create: if
          signedIn()
          && (
            isRootAdmin()
            || isShopOwner(shopId)
            || canManageInventory(shopId)
          )
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.currentStock is number
          && request.resource.data.currentStock >= 0
          && request.resource.data.currentStock <= 0
          && request.resource.data.enabled is bool;

        allow update: if
          request.resource.data.shopId == shopId
          && (
            isRootAdmin()
            || isShopOwner(shopId)
            || canManageInventory(shopId)
            || isShopMember(shopId)
          );

        allow delete: if false;

        match /batches/{batchId} {
          allow read: if isRootAdmin() || isShopMember(shopId);

          allow create: if
            (isRootAdmin() || isShopMember(shopId))
            && request.resource.data.shopId == shopId
            && request.resource.data.inventoryItemId == itemId
            && request.resource.data.quantityReceived is number
            && request.resource.data.quantityReceived > 0;

          allow update: if isRootAdmin() || isShopMember(shopId);
          allow delete: if false;
        }

        match /movements/{movementId} {
          allow read: if isRootAdmin() || isShopMember(shopId) || canViewInventory(shopId);

          allow create: if
            signedIn()
            && (isRootAdmin() || isShopMember(shopId))
            && request.resource.data.shopId == shopId
            && request.resource.data.inventoryItemId == itemId
            && request.resource.data.type is string
            && request.resource.data.quantityChange is number
            && request.resource.data.stockBefore is number
            && request.resource.data.stockAfter is number;

          allow update, delete: if false;
        }
      }

      // 📦 庫存消耗／返還幂等紀錄
      match /inventory_consumptions/{consumptionId} {
        allow read: if
          isRootAdmin()
          || isShopMember(shopId);

        allow create: if
          signedIn()
          && (isRootAdmin() || isShopMember(shopId))
          && request.resource.data.shopId == shopId
          && request.resource.data.sourceId is string
          && request.resource.data.operation in ['deduct', 'return']
          && request.resource.data.status == 'completed';

        allow update, delete: if false;
      }

      // 🧹 住宿耗材設定
      match /booking_supply_settings/{settingId} {
        allow read: if isRootAdmin() || isShopMember(shopId);

        allow create, update: if
          (isRootAdmin() || canManageInventory(shopId) || isShopOwner(shopId) || isShopMember(shopId))
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;

        allow delete: if false;
      }

      match /store_products/{productId} {
        allow read: if
          isRootAdmin()
          || isShopMember(shopId)
          || isShopOwnerUid(shopId)
          || resource.data.enabled == true;

        // 商城商品寫入：店主（member role 或 shops.ownerUid）或 manage_store_products。
        // 沒有 keys().hasOnly，庫存連動 snapshot 欄位可以一併寫入。
        // 不允許 Customer / public write。
        allow create, update: if
          signedIn()
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && (
            isRootAdmin()
            || isShopOwner(shopId)
            || isShopOwnerUid(shopId)
            || canManageStoreProducts(shopId)
          );

        allow delete: if
          isRootAdmin()
          || isShopOwner(shopId)
          || isShopOwnerUid(shopId)
          || canManageStoreProducts(shopId);
      }

      match /store_promotions/{promotionId} {
        allow read: if
          isRootAdmin()
          || isShopOwner(shopId)
          || canManageStoreProducts(shopId)
          || isShopMember(shopId)
          || (
            resource.data.enabled == true
            && resource.data.archived != true
          );

        allow create, update: if
          signedIn()
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && (
            isRootAdmin()
            || isShopOwner(shopId)
            || canManageStoreProducts(shopId)
          );

        allow delete: if
          isRootAdmin()
          || isShopOwner(shopId)
          || canManageStoreProducts(shopId);
      }

      match /store_categories/{categoryId} {
        allow read: if true;

        allow create, update: if
          canManageStoreProducts(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;

        allow delete: if false;
      }

      // 商城活動海報 banners[]、bannerAutoPlay 存在此文件，無獨立 collection。
      match /store_settings/{settingId} {
        allow read: if true;

        allow create, update: if canManageStoreSettings(shopId);
        allow delete: if false;
      }

      match /store_carts/{userId} {
        allow read, create, update: if
          isRootAdmin()
          || isShopMember(shopId)
          || (signedIn() && request.auth.uid == userId);

        allow delete: if
          isRootAdmin()
          || (signedIn() && request.auth.uid == userId);
      }

      match /store_orders/{orderId} {
        allow read: if
          isRootAdmin()
          || canViewStoreOrders(shopId)
          || (signedIn() && resource.data.userId == request.auth.uid);

        allow create, update, delete: if false;
      }

      match /store_reservations/{reservationId} {
        allow read: if
          isRootAdmin()
          || canViewStoreOrders(shopId)
          || (signedIn() && resource.data.userId == request.auth.uid);

        allow create, update, delete: if false;
      }

      match /store_counters/{counterId} {
        allow read: if isRootAdmin() || isShopMember(shopId);
        allow create, update, delete: if false;
      }
    }

   // 📝 操作紀錄
match /action_logs/{logId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin() ||

      (
        request.resource.data.operatorUid == request.auth.uid &&
        request.resource.data.shopId is string &&
        request.resource.data.type == 'booking_cancelled'
      )
    );

  allow update, delete: if false;
}

    // 🔗 會員綁定 / 合併申請
match /member_link_requests/{requestId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin()
    );

 allow update: if signedIn() &&
  (
    isShopMember(resource.data.shopId) ||
    isRootAdmin()
  );
  allow delete: if false;
}

// 🗑️ 帳號刪除申請
match /account_delete_requests/{requestId} {

  allow create: if signedIn()
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == 'pending';

  allow read: if signedIn()
    && (
      isRootAdmin()
      || resource.data.uid == request.auth.uid
    );

  allow update, delete: if isRootAdmin();
}
// 🔢 店家訂單流水號
match /booking_counters/{shopId} {
  allow read: if signedIn();

  allow create, update: if signedIn()
    && (
      isShopMember(shopId)
      || isRootAdmin()
      || (
        request.resource.data.keys().hasOnly([
          'current',
          'updatedAt'
        ])
        && request.resource.data.current is int
        && (
          !exists(/databases/$(database)/documents/booking_counters/$(shopId)) ||
          request.resource.data.current == resource.data.current + 1
        )
      )
    );

  allow delete: if false;
}

  
    // 📊 退房報表
match /reports/{reportId} {
  allow read: if signedIn() &&
    (
      isShopMember(resource.data.shopId) ||
      isRootAdmin()
    );

  allow create: if signedIn() &&
    (
      isShopMember(request.resource.data.shopId) ||
      isRootAdmin()
    );

  allow update, delete: if false;
}

// ⭐ 評價
match /reviews/{reviewId} {
  allow read: if true;

  allow create: if signedIn()
  && request.resource.data.userId == request.auth.uid
  && request.resource.data.shopId is string
  && request.resource.data.bookingId is string
  && request.resource.data.status == 'visible'
  && request.resource.data.rating >= 1
  && request.resource.data.rating <= 5
  && request.resource.data.environmentRating >= 1
  && request.resource.data.environmentRating <= 5
  && request.resource.data.serviceRating >= 1
  && request.resource.data.serviceRating <= 5
  && request.resource.data.priceRating >= 1
  && request.resource.data.priceRating <= 5
  && request.resource.data.imageUrls is list
  && request.resource.data.imageUrls.size() <= 5
  && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
  && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.shopId == request.resource.data.shopId
  && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'completed';

  allow update: if isRootAdmin()
    ||
    (
      signedIn()
      && resource.data.userId == request.auth.uid
      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'content',
        'imageUrls',
        'updatedAt'
      ])
      && request.resource.data.imageUrls is list
      && request.resource.data.imageUrls.size() <= 5
    )
    ||
    (
      signedIn()
      && isShopMember(resource.data.shopId)
      && request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'reply',
        'replyAt',
        'replyBy',
        'updatedAt'
      ])
      && request.resource.data.replyBy == request.auth.uid
    );

  allow delete: if isRootAdmin();
}
// 📦 訂單
match /bookings/{bookingId} {

allow read: if signedIn();

allow create: if signedIn()
  &&
  request.resource.data.shopId is string
  &&
  request.resource.data.status == 'pending'
  &&
  (
    request.resource.data.userId == request.auth.uid
    ||
    (
      request.resource.data.source == 'admin'
      &&
      isShopMember(request.resource.data.shopId)
    )
    ||
    isRootAdmin()
  );

allow update: if signedIn() &&
  (
    isShopMember(resource.data.shopId) ||
    isRootAdmin() ||

    (
      resource.data.userId == request.auth.uid &&
      resource.data.status == 'completed' &&
      !(resource.data.reviewed == true) &&
      request.resource.data.reviewed == true &&
      request.resource.data.reviewId is string &&
      request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'reviewed',
        'reviewId',
        'updatedAt'
      ])
    ) ||

  (
  resource.data.userId == request.auth.uid
  &&
  request.resource.data.diff(resource.data).changedKeys().hasOnly([
    'status',
    'cancelReason',
    'cancelBy',
    'cancelledAt',
    'updatedAt',
    'transferImageUrl',
    'transferLast5',
    'depositStatus',
    'depositSubmittedAt',
    'depositExpired',
    'assignStatus'
  ])
)
  );

allow delete: if signedIn() &&
  (
    isRootAdmin() ||
    (
      resource.data.shopId is string &&
      isShopMember(resource.data.shopId) &&
      resource.data.status == 'cancelled'
    )
  );

  match /messages/{messageId} {

    allow read: if signedIn() &&
  (
    get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId
      == request.auth.uid
    ||
    isShopMember(
      get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
    )
    ||
    isRootAdmin()
  );

    allow create: if signedIn()
      &&
      request.resource.data.senderId == request.auth.uid
      &&
      (
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId
          == request.auth.uid
        ||
        isShopMember(
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.shopId
        )
        ||
        isRootAdmin()
      );

    allow update, delete: if false;
  }
}

       // 📮 店主 / 店家聯絡平台
    match /platform_contact_requests/{requestId} {
      allow read: if signedIn() &&
  (
    isRootAdmin() ||
    (
      resource.data.shopId is string &&
      isShopMember(resource.data.shopId)
    ) ||
    resource.data.userId == request.auth.uid
  );
      allow create: if signedIn() &&
        request.resource.data.source == 'shop_owner' &&
        request.resource.data.shopId is string &&
        isShopMember(request.resource.data.shopId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';

      allow update: if isRootAdmin();

      allow delete: if false;

            // 💬 聯絡平台對話紀錄
      match /messages/{messageId} {
        allow read: if signedIn() &&
          (
            isRootAdmin() ||
            isShopMember(get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.shopId)
          );

        allow create: if signedIn() &&
  get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.status != 'closed' &&
  (
    (
      isRootAdmin() &&
      request.resource.data.senderType == 'platform'
    ) ||
    (
      request.resource.data.senderType == 'shop_owner' &&
      isShopMember(get(/databases/$(database)/documents/platform_contact_requests/$(requestId)).data.shopId)
    )
  ) &&
  request.resource.data.senderUid == request.auth.uid;

        allow update, delete: if false;
      }
    }

// 📨 店家重要資料修改申請
match /shop_change_requests/{requestId} {

  allow read: if signedIn() &&
    (
      isRootAdmin() ||
      (
        resource.data.shopId is string &&
        isShopMember(resource.data.shopId)
      )
    );

  allow create: if signedIn() &&
    (
      request.resource.data.shopId is string &&
      isShopMember(request.resource.data.shopId)
    );

  allow update: if isRootAdmin();

  allow delete: if isRootAdmin();
}

    // 📜 平台條款
   match /platform_policies/{policyId} {
  allow read: if true;
  allow create, update, delete: if isRootAdmin();

  match /versions/{versionId} {
    allow read: if true;
    allow create, update, delete: if isRootAdmin();
  }
}

// 🔢 平台流水號計數器
match /platform_counters/{counterId} {
  allow read: if isRootAdmin() || (signedIn() && counterId == 'shops');

  allow create, update: if signedIn()
    && counterId == 'shops'
    && request.resource.data.keys().hasOnly([
      'current',
      'updatedAt'
    ])
    && request.resource.data.current is int
    && (
      !exists(/databases/$(database)/documents/platform_counters/$(counterId)) ||
      request.resource.data.current ==
        resource.data.current + 1
    );

  allow delete: if isRootAdmin();
}

// 🎟 激活碼
match /activation_codes/{codeId} {

  // 登入後可查詢激活碼
  allow read: if signedIn();

  // 只有平台可建立 / 刪除激活碼
  allow create, delete: if isRootAdmin();

  // 平台可管理；一般使用者只能在創店時更新使用紀錄欄位
  allow update: if isRootAdmin()
    ||
    (
      signedIn()
      &&
      request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'usedCount',
        'usedShopIds',
        'usedByUids',
        'lastUsedAt',
        'updatedAt',
      ])
      &&
(
  request.resource.data.usedCount == resource.data.usedCount + 1
  ||
  (
    !('usedCount' in resource.data.keys())
    &&
    request.resource.data.usedCount == 1
  )
)
    );

  // 🎟 激活碼使用紀錄
  match /usage_logs/{logId} {
    allow read: if isRootAdmin();

    allow create: if signedIn()
      &&
      request.resource.data.usedByUid == request.auth.uid
      &&
      request.resource.data.shopId == logId;

    allow update, delete: if isRootAdmin();
  }
}
    // 👑 平台人員與權限資料
// 功能：根管理員可管理平台人員；一般平台人員只能查看自己的權限資料。
match /platform_users/{platformUid} {

  // 根管理員可查看全部資料。
  // 一般平台人員只能查看自己的資料。
  allow read: if isRootAdmin() || isSelf(platformUid);

  // 只有根管理員可以新增平台人員。
  allow create: if isRootAdmin()
    && request.resource.data.uid == platformUid
    && (
      platformUid != '7FNrECQeqAca9Vu8lBBzTSdcJcg1'
      ||
      (
        request.resource.data.role == 'super_admin'
        && request.resource.data.enabled == true
        && request.resource.data.permissions is list
        && request.resource.data.permissions.hasAll(['all'])
      )
    );

  // 只有根管理員可以修改平台人員。
  // 修改根管理員自己的文件時，必須維持最高權限。
  allow update: if isRootAdmin()
    && request.resource.data.uid == platformUid
    && (
      platformUid != '7FNrECQeqAca9Vu8lBBzTSdcJcg1'
      ||
      (
        request.resource.data.role == 'super_admin'
        && request.resource.data.enabled == true
        && request.resource.data.permissions is list
        && request.resource.data.permissions.hasAll(['all'])
      )
    );

  // 可以刪除其他平台人員，
  // 但永遠不能透過 App 刪除根管理員。
  allow delete: if isRootAdmin()
    && platformUid != '7FNrECQeqAca9Vu8lBBzTSdcJcg1';
}

    // 📜 平台條款版本
    match /platform_policy_versions/{versionId} {
      allow read, write: if isRootAdmin();
    }

// 🔔 App 通知中心
match /notifications/{notificationId} {

  // 本人可查看自己的通知
  // Root Admin 可查看全部
  allow read: if signedIn() &&
    (
      isRootAdmin() ||
      resource.data.userId == request.auth.uid
    );

  // 只能由 Cloud Functions(Admin SDK) 建立
  allow create: if false;

  // 本人只能修改已讀狀態
  allow update: if signedIn()
    && resource.data.userId == request.auth.uid
    && request.resource.data.diff(resource.data).changedKeys().hasOnly([
      'isRead',
      'readAt'
    ]);

  // 不允許刪除
  allow delete: if false;
}

    // 🔔 平台通知
match /shop_notifications/{notificationId} {
  allow read: if signedIn() &&
    (
      isRootAdmin() ||
      isShopMember(resource.data.shopId)
    );

  allow create, delete: if isRootAdmin();

allow update: if
  isRootAdmin()
  ||
  (
    isShopMember(resource.data.shopId)
    &&
    request.resource.data.shopId == resource.data.shopId
    &&
    request.resource.data.title == resource.data.title
    &&
    request.resource.data.content == resource.data.content
    &&
    request.resource.data.type == resource.data.type
    &&
    request.resource.data.createdAt == resource.data.createdAt
  );
}
// ============================================================
// 🐾 每日照護紀錄
// Firestore：daily_care_records/{recordId}
// 功能：
// 1. 店家人員在入住期間填寫 / 修改
// 2. 該訂單會員只能查看自己的紀錄
// 3. 一般會員不能自行建立或修改
// ============================================================
match /daily_care_records/{recordId} {

  // 店家人員、Root Admin、該訂單會員可以讀取
  allow read: if signedIn()
    && (
      isRootAdmin()

      ||

      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )

      ||

      (
        resource.data.bookingId is string
        && exists(
          /databases/$(database)/documents/bookings/$(resource.data.bookingId)
        )
        && get(
          /databases/$(database)/documents/bookings/$(resource.data.bookingId)
        ).data.userId == request.auth.uid
      )
    );

  // 只有店家人員 / Root Admin 可以新增
  // 而且必須真的是該店訂單，並且目前已入住
  allow create: if signedIn()
    && request.resource.data.shopId is string
    && request.resource.data.bookingId is string
    && exists(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    )
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.shopId == request.resource.data.shopId
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.status == 'checked_in'
    && (
      isRootAdmin()
      || isShopMember(request.resource.data.shopId)
    );

  // 店家人員可以修改已存在的照護紀錄
  // 不允許把紀錄轉移到別家店 / 別張訂單 / 別房間
  allow update: if signedIn()
    && (
      isRootAdmin()
      ||
      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )
    )
        && resource.data.bookingId is string
    && exists(
      /databases/$(database)/documents/bookings/$(resource.data.bookingId)
    )
    && get(
      /databases/$(database)/documents/bookings/$(resource.data.bookingId)
    ).data.status == 'checked_in'
    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.bookingId == resource.data.bookingId
    && request.resource.data.roomId == resource.data.roomId
    && request.resource.data.recordDate == resource.data.recordDate
    && request.resource.data.sessionIndex == resource.data.sessionIndex;

  // 照護紀錄保留作為住宿紀錄，不由 App 直接刪除
  allow delete: if false;
}


// ============================================================
// 📷 每日照護照片資料
// Firestore：daily_care_photos/{photoId}
// 注意：真正圖片檔案的權限下一步在 storage.rules 補。
// ============================================================
match /daily_care_photos/{photoId} {

  // 店家人員、Root Admin、該訂單會員可以查看
  allow read: if signedIn()
    && (
      isRootAdmin()

      ||

      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )

      ||

      (
        resource.data.bookingId is string
        && exists(
          /databases/$(database)/documents/bookings/$(resource.data.bookingId)
        )
        && get(
          /databases/$(database)/documents/bookings/$(resource.data.bookingId)
        ).data.userId == request.auth.uid
      )
    );

  // 只有店家人員 / Root Admin 可以建立照片紀錄
  allow create: if signedIn()
    && request.resource.data.shopId is string
    && request.resource.data.bookingId is string
    && exists(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    )
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.shopId == request.resource.data.shopId
    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.status == 'checked_in'
    && (
      isRootAdmin()
      || isShopMember(request.resource.data.shopId)
    );

  // 前端目前不需要直接修改照片 metadata
  allow update: if false;

  // 店員誤傳照片時允許刪除
  allow delete: if signedIn()
    && (
      isRootAdmin()
      ||
      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )
    );
}
// ============================================================
// 📥 每日照護高清照片下載資料
// Firestore：daily_care_photo_downloads/{photoId}
//
// 功能：
// 1. 保存受保護的高清 downloadStoragePath 與下載 metadata
// 2. 一般會員入住期間不可讀取
// 3. 目前先只允許店家人員 / Root Admin 存取
// 4. 後續再加入 completed + checkOutAt + expiresAt 的會員下載條件
// ============================================================
match /daily_care_photo_downloads/{photoId} {

  // 目前只有店家人員 / Root Admin 可以讀取高清資料。
allow read: if signedIn()
  && (
    isRootAdmin()

    ||

    (
      resource.data.shopId is string
      && isShopMember(resource.data.shopId)
    )

    ||

    (
      resource.data.bookingId is string

      && resource.data.expiresAt is timestamp

      && exists(
        /databases/$(database)/documents/bookings/$(resource.data.bookingId)
      )

      && get(
        /databases/$(database)/documents/bookings/$(resource.data.bookingId)
      ).data.userId == request.auth.uid

      && get(
        /databases/$(database)/documents/bookings/$(resource.data.bookingId)
      ).data.status == 'completed'

      && get(
  /databases/$(database)/documents/bookings/$(resource.data.bookingId)
).data.shopId == resource.data.shopId

      && request.time < resource.data.expiresAt
    )
  );

   // 建立高清資料時：
  // - 只能保存必要的高清 metadata
  // - 不允許保存 downloadUrl
  // - 必須是店家 / Root Admin
  // - booking 必須存在
  // - booking 必須屬於相同 shop
  // - booking 必須正在 checked_in
  allow create: if signedIn()

    && request.resource.data.keys().hasOnly([
      'shopId',
      'bookingId',
      'photoId',
      'downloadStoragePath',
      'downloadBytes',
      'expiresAt',
      'createdAt'
    ])

    && request.resource.data.shopId is string
    && request.resource.data.bookingId is string
    && request.resource.data.photoId == photoId

    && request.resource.data.downloadStoragePath is string
    && request.resource.data.downloadStoragePath.size() > 0

    && (
      request.resource.data.downloadBytes == null
      || request.resource.data.downloadBytes is int
    )

    && request.resource.data.expiresAt == null

    && exists(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    )

    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.shopId == request.resource.data.shopId

    && get(
      /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
    ).data.status == 'checked_in'

    && (
      isRootAdmin()
      || isShopMember(request.resource.data.shopId)
    );
  // 退房後只允許店家 / Root Admin 更新下載期限。
  // 其他高清資料不可修改，也不能新增 downloadUrl。
  allow update: if signedIn()

    && (
      isRootAdmin()
      ||
      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )
    )

    && request.resource.data.keys().hasOnly([
      'shopId',
      'bookingId',
      'photoId',
      'downloadStoragePath',
      'downloadBytes',
      'expiresAt',
      'createdAt'
    ])

    && request.resource.data.shopId == resource.data.shopId
    && request.resource.data.bookingId == resource.data.bookingId
    && request.resource.data.photoId == resource.data.photoId
    && request.resource.data.downloadStoragePath
      == resource.data.downloadStoragePath
    && request.resource.data.downloadBytes
      == resource.data.downloadBytes
    && request.resource.data.createdAt
      == resource.data.createdAt

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'expiresAt'
      ])

    && request.resource.data.expiresAt is timestamp;
  // 高清下載 metadata 只允許店家 / Root Admin 刪除。
  allow delete: if signedIn()
    && (
      isRootAdmin()
      ||
      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )
    );
}
// ============================================================
// 💳 金流交易紀錄
// Firestore：payments/{paymentId}
// 功能：
// 1. 店家成員只能查看自己店家的交易
// 2. 會員只能查看自己的交易
// 3. Root Admin 可查看全部交易
// 4. Payment 建立與狀態更新只允許後端 Cloud Functions 處理
// ============================================================
match /payments/{paymentId} {

  allow read: if signedIn()
    && (
      isRootAdmin()

      ||

      (
        resource.data.shopId is string
        && isShopMember(resource.data.shopId)
      )

      ||

      (
        resource.data.userId is string
        && resource.data.userId == request.auth.uid
      )
    );

  // Payment 屬於敏感金流資料。
  // Flutter / Web 前端不可直接建立、修改或刪除。
  // Cloud Functions 使用 Admin SDK，不受 Firestore Rules 限制。
  allow create, update, delete: if false;
}

match /{path=**}/store_orders/{orderId} {
  allow read: if isRootAdmin()
    || (
      signedIn()
      && resource.data.userId is string
      && resource.data.userId == request.auth.uid
    )
    || (
      resource.data.shopId is string
      && canViewStoreOrders(resource.data.shopId)
    );

  allow create, update, delete: if false;
}

    // 🚫 其他全部拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}